#version 450
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(binding=0) uniform sampler2DArray source_image;
layout(binding=1, std430) writeonly buffer Blocks { uvec4 blocks[]; };
layout(push_constant) uniform Params { uint width; uint height; uint layers; uint srgb; uint block_dim; } pc;
vec3 to_srgb(vec3 x) {
    return mix(1.055 * pow(max(x, vec3(0)), vec3(1.0/2.4)) - 0.055,
               12.92 * x, lessThanEqual(x, vec3(0.0031308)));
}
void write_bits(inout uvec4 block, uint value, uint count, uint offset) {
    for (uint i=0; i<count; ++i) {
        uint bit = offset+i;
        block[bit/32] |= ((value>>i)&1u) << (bit%32);
    }
}
void main() {
    uvec3 id=gl_GlobalInvocationID;
    uint dim=pc.block_dim;
    uvec2 grid=(uvec2(pc.width,pc.height)+dim-1u)/dim;
    if (id.x>=grid.x || id.y>=grid.y || id.z>=pc.layers) return;
    vec4 colors[36];
    uint count=dim*dim;
    vec4 mean=vec4(0);
    bool opaque=true;
    for (uint i=0; i<count; ++i) {
        uvec2 pixel=min(id.xy*dim+uvec2(i%dim,i/dim), uvec2(pc.width-1u,pc.height-1u));
        vec2 uv=(vec2(pixel)+0.5)/vec2(pc.width,pc.height);
        vec4 c=textureLod(source_image,vec3(uv,float(id.z)),0.0);
        if (pc.srgb!=0u) c.rgb=to_srgb(c.rgb);
        colors[i]=clamp(c,0.0,1.0); mean+=colors[i];
        opaque=opaque && colors[i].a>=0.999;
    }
    mean/=float(count);
    // Principal-axis endpoint fit retains anti-correlated channels (e.g. normals).
    vec4 axis=vec4(1,0,0,0); float longest=0.0;
    for (uint i=0; i<count; ++i) {
        vec4 d=colors[i]-mean;
        if (dot(d,d)>longest) { longest=dot(d,d); axis=normalize(d); }
    }
    for (uint iteration=0; iteration<4; ++iteration) {
        vec4 next=vec4(0);
        for (uint i=0; i<count; ++i) { vec4 d=colors[i]-mean; next+=d*dot(d,axis); }
        axis=dot(next,next)>1e-16 ? normalize(next) : axis;
    }
    float lo=1e20, hi=-1e20;
    for (uint i=0; i<count; ++i) { float p=dot(colors[i]-mean,axis); lo=min(lo,p); hi=max(hi,p); }
    vec4 a=clamp(mean+axis*lo,0.0,1.0), b=clamp(mean+axis*hi,0.0,1.0);
    // RGBA direct endpoint mode uses RGB sum ordering to select blue contraction.
    if (dot(a.rgb,vec3(1))>dot(b.rgb,vec3(1))) { vec4 t=a; a=b; b=t; }
    uvec4 ea=uvec4(round(a*255.0)), eb=uvec4(round(b*255.0));
    if (ea.r+ea.g+ea.b>eb.r+eb.g+eb.b) { uvec4 t=ea; ea=eb; eb=t; }
    a=vec4(ea)/255.0; b=vec4(eb)/255.0;
    // Opaque: 4x4 weights, QUANT_8, RGB direct endpoints (mode 8).
    // Alpha: 4x4 weights, QUANT_4, RGBA direct endpoints (mode 12).
    // Both leave enough color bits for QUANT_256 endpoint integers.
    uint bits=opaque?3u:2u, max_weight=opaque?7u:3u;
    uvec4 block=uvec4(0);
    write_bits(block,opaque?0x53u:0x42u,11u,0u);
    write_bits(block,opaque?8u:12u,4u,13u);
    for (uint c=0; c<(opaque?3u:4u); ++c) {
        write_bits(block,ea[c],8u,17u+c*16u);
        write_bits(block,eb[c],8u,25u+c*16u);
    }
    vec4 delta=b-a;
    float denom=dot(delta,delta);
    // A 4x4 weight grid is legal for both 4x4 and 6x6 ASTC blocks. For 6x6,
    // fit weights at the grid vertices; hardware interpolates the interior.
    for (uint i=0; i<16; ++i) {
        vec2 p=vec2(i%4u,i/4u)*float(dim-1u)/3.0;
        uvec2 lo_p=uvec2(floor(p)), hi_p=min(lo_p+1u,uvec2(dim-1u));
        vec2 f=fract(p);
        vec4 color=mix(mix(colors[lo_p.y*dim+lo_p.x],colors[lo_p.y*dim+hi_p.x],f.x),
                       mix(colors[hi_p.y*dim+lo_p.x],colors[hi_p.y*dim+hi_p.x],f.x),f.y);
        float t=denom>1e-12?clamp(dot(color-a,delta)/denom,0.0,1.0):0.0;
        // ASTC weights are quantized to {0,21,43,64} or {0,9,18,27,37,46,55,64}.
        uint weight=0u; float error=1e20;
        for (uint q=0u; q<=max_weight; ++q) {
            float decoded=round(float(q)*64.0/float(max_weight))/64.0;
            float e=abs(t-decoded); if (e<error) { error=e; weight=q; }
        }
        // Weight bitstream is reversed relative to endpoint/header bitstream.
        for (uint j=0; j<bits; ++j) write_bits(block,(weight>>j)&1u,1u,127u-(i*bits+j));
    }
    blocks[(id.z*grid.y+id.y)*grid.x+id.x]=block;
}
