+void ReviewPublicPublication(Harness& h) {
+    const auto* a = FindFixture("constant_a");
+    const auto* b = FindFixture("constant_b");
+    if (!a || !b) { Check("RVP0", "review fixture setup", false); return; }
+    auto warm = RunFixture(h, *a, [](RegisterPatch&) {});
+    if (!warm.ok || warm.result.snapshot.registers.Get(Gpr::Rax) != 17) {
+        Check("RVP0", "warm old translation", false); return;
+    }
+    GuestRange range{GuestAddress{h.code_base}, kMappingSize};
+    if (!h.space->Protect(range, GuestPermission::Read | GuestPermission::Write)) {
+        Check("RVP0", "make code writable", false); return;
+    }
+    auto q = h.space->Quiesce(1'000'000);
+    if (!q) { Check("RVP0", "quiesce", false); return; }
+    std::vector<std::byte> bytes(kMappingSize);
+    std::memcpy(bytes.data(), b->bytes.data(), b->bytes.size());
+    std::memcpy(bytes.data() + b->gate_offset, &h.return_gate, sizeof(h.return_gate));
+    const auto gen = h.space->CodeGeneration();
+    auto pub = h.space->PublishCode(q.Value(), range, bytes);
+    auto inv = h.space->InvalidateCode(q.Value(), range, InvalidationReason::HostWrite);
+    auto rx = h.space->Protect(range, GuestPermission::Read | GuestPermission::Execute);
+    if (!pub || !inv || !rx) { Check("RVP0", "publish B through GuestAddressSpace", false); return; }
+    printf("review generation before=%llu after=%llu\n", (unsigned long long)gen,
+           (unsigned long long)h.space->CodeGeneration());
+    ThreadInit init{};
+    init.entry_rip = GuestCodeAddress{h.code_base};
+    init.initial_rsp = GuestAddress{h.stack_top};
+    auto thread = h.context->CreateThread(init);
+    if (!thread) { Check("RVP0", "create thread", false); return; }
+    // Keep q alive: this separately tests admission during the transaction.
+    auto run = h.context->Run(thread.Value(), RunOptions{});
+    Check("RVP1", "Run must refuse entry while publication token is held", !run);
+    if (run) CheckU64("RVP2", "public publication must execute new constant B",
+                      run.Value().snapshot.registers.Get(Gpr::Rax), 34);
+    Check("RVP3", "review thread cleaned up", bool(h.context->DestroyThread(thread.Value())));
+}
