#version 450 core

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint NUM_SAMPLES = 1;
layout(constant_id = 1) const uint MICRO_TILE_MODE = 1;
layout(constant_id = 2) const uint MICRO_TILE_THICKNESS = 1;
layout(constant_id = 3) const uint IS_TILER = 0;
#if IS_MACRO_TILED
layout(constant_id = 4) const uint ARRAY_MODE = 0;
layout(constant_id = 5) const uint PIPE_CONFIG = 0;
layout(constant_id = 6) const uint BANK_WIDTH = 1;
layout(constant_id = 7) const uint BANK_HEIGHT = 1;
layout(constant_id = 8) const uint NUM_BANKS = 1;
layout(constant_id = 9) const uint NUM_BANK_BITS = 1;
layout(constant_id = 10) const uint TILE_SPLIT_BYTES = 1;
layout(constant_id = 11) const uint MACRO_TILE_ASPECT = 1;
#endif

#define BYTES_PER_PIXEL (BITS_PER_PIXEL / 8)

#if BITS_PER_PIXEL == 8
// shaderInt8 does not imply storageBuffer8BitAccess (Turnip exposes only the
// former). Keep byte textures in packed words, without an 8-bit SSBO capability.
#define BLOCK_TYPE uint32_t
#elif BITS_PER_PIXEL == 16
#define BLOCK_TYPE uint16_t
#elif BITS_PER_PIXEL == 32
#define BLOCK_TYPE uint32_t
#elif BITS_PER_PIXEL == 64
#define BLOCK_TYPE u32vec2
#elif BITS_PER_PIXEL == 96
#define BLOCK_TYPE u32vec3
#else
#define BLOCK_TYPE u32vec4
#endif

#if IS_MACRO_TILED
const uint NUM_PIPES = PIPE_CONFIG == 0 ? 2 : 8;
const uint NUM_PIPE_BITS = PIPE_CONFIG == 0 ? 1 : 3;
#endif

#define MICRO_TILE_WIDTH 8
#define MICRO_TILE_HEIGHT 8
#define MICRO_TILE_PIXELS (MICRO_TILE_WIDTH * MICRO_TILE_HEIGHT)
#define MICRO_TILE_BITS (MICRO_TILE_PIXELS * MICRO_TILE_THICKNESS * BITS_PER_PIXEL * NUM_SAMPLES)
#define MICRO_TILE_BYTES (MICRO_TILE_BITS / 8)

#define NUM_PIPE_INTERLEAVE_BITS 8

#define ADDR_SURF_DISPLAY_MICRO_TILING 0
#define ADDR_SURF_THIN_MICRO_TILING 1
#define ADDR_SURF_DEPTH_MICRO_TILING 2
#define ADDR_SURF_ROTATED_MICRO_TILING 3

#define ARRAY_LINEAR_GENERAL 0
#define ARRAY_LINEAR_ALIGNED 1
#define ARRAY_1D_TILED_THIN1 2
#define ARRAY_1D_TILED_THICK 3
#define ARRAY_2D_TILED_THIN1 4
#define ARRAY_PRT_TILED_THIN1 5
#define ARRAY_PRT_2D_TILED_THIN1 6
#define ARRAY_2D_TILED_THICK 7
#define ARRAY_2D_TILED_XTHICK 8
#define ARRAY_PRT_TILED_THICK 9
#define ARRAY_PRT_2D_TILED_THICK 10
#define ARRAY_PRT_3D_TILED_THIN1 11
#define ARRAY_3D_TILED_THIN1 12
#define ARRAY_3D_TILED_THICK 13
#define ARRAY_3D_TILED_XTHICK 14
#define ARRAY_PRT_3D_TILED_THICK 15

#define	ADDR_SURF_P2 0
#define	ADDR_SURF_P8_32x32_8x16	10
#define	ADDR_SURF_P8_32x32_16x16 12

#define BITS_PER_BYTE 8
#define BITS_TO_BYTES(x) (((x) + (BITS_PER_BYTE-1)) / BITS_PER_BYTE)

#define _BIT(v, b) bitfieldExtract((v), (b), 1)

struct MipInfo {
    uint size;
    uint pitch;
    uint height;
    uint offset;
};

layout (set = 0, binding = 0, scalar) buffer InputBuf {
    BLOCK_TYPE tiled_data[];
};

#ifdef FROM_IMAGE
// Fused readback: the tiler samples the (scaled) host image directly at the guest's
// native texel centres and packs the raw format bits, instead of blitting to a
// native-size temporary, copying it to a linear buffer and tiling that.
layout (set = 0, binding = 1) uniform sampler2DArray src_image;
#else
layout (set = 0, binding = 1, scalar) buffer OutputBuf {
    BLOCK_TYPE linear_data[];
};
#endif

layout (set = 0, binding = 2, scalar) uniform TilingInfo {
    uint bank_swizzle;
    uint num_slices;
    uint num_mips;
    uint micro_mip_mask;
    MipInfo mips[16];
    uint native_width;   // FROM_IMAGE: guest (native) extent of mip 0
    uint native_height;
    uint pack_kind;      // informational; the pack is a specialization constant
    uint reserved;
} info;

uint32_t ComputePixelIndexWithinMicroTile(uint32_t x, uint32_t y, uint32_t z) {
    uint32_t p0 = 0;
    uint32_t p1 = 0;
    uint32_t p2 = 0;
    uint32_t p3 = 0;
    uint32_t p4 = 0;
    uint32_t p5 = 0;
    uint32_t p6 = 0;
    uint32_t p7 = 0;
    uint32_t p8 = 0;

    uint32_t x0 = _BIT(x, 0);
    uint32_t x1 = _BIT(x, 1);
    uint32_t x2 = _BIT(x, 2);
    uint32_t y0 = _BIT(y, 0);
    uint32_t y1 = _BIT(y, 1);
    uint32_t y2 = _BIT(y, 2);
    uint32_t z0 = _BIT(z, 0);
    uint32_t z1 = _BIT(z, 1);
    uint32_t z2 = _BIT(z, 2);

    if (MICRO_TILE_MODE == ADDR_SURF_DISPLAY_MICRO_TILING) {
#if BITS_PER_PIXEL == 8
        p0 = x0;
        p1 = x1;
        p2 = x2;
        p3 = y1;
        p4 = y0;
        p5 = y2;
#elif BITS_PER_PIXEL == 16
        p0 = x0;
        p1 = x1;
        p2 = x2;
        p3 = y0;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 32
        p0 = x0;
        p1 = x1;
        p2 = y0;
        p3 = x2;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 64
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = x2;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 128
        p0 = y0;
        p1 = x0;
        p2 = x1;
        p3 = x2;
        p4 = y1;
        p5 = y2;
#endif
    } else if (MICRO_TILE_MODE == ADDR_SURF_THIN_MICRO_TILING ||
        MICRO_TILE_MODE == ADDR_SURF_DEPTH_MICRO_TILING) {
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = y1;
        p4 = x2;
        p5 = y2;
    } else {
#if BITS_PER_PIXEL == 8 || BITS_PER_PIXEL == 16
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = y1;
        p4 = z0;
        p5 = z1;
#elif BITS_PER_PIXEL == 32
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = z0;
        p4 = y1;
        p5 = z1;
#elif BITS_PER_PIXEL == 64 || BITS_PER_PIXEL == 128
        p0 = x0;
        p1 = y0;
        p2 = z0;
        p3 = x1;
        p4 = y1;
        p5 = z1;
#endif
        p6 = x2;
        p7 = y2;

        if (MICRO_TILE_THICKNESS == 8) {
            p8 = z2;
        }
    }

    uint32_t pixel_number =
        ((p0) | (p1 << 1) | (p2 << 2) | (p3 << 3) | (p4 << 4) |
         (p5 << 5) | (p6 << 6) | (p7 << 7) | (p8 << 8));

    return pixel_number;
}

uint32_t ComputeSurfaceAddrFromCoordMicroTiled(uint32_t x, uint32_t y, uint32_t slice, uint32_t pitch, uint32_t height, uint32_t sample_index) {
    uint32_t slice_bytes = BITS_TO_BYTES(pitch * height * MICRO_TILE_THICKNESS * BITS_PER_PIXEL * NUM_SAMPLES);

    uint32_t micro_tiles_per_row = pitch / MICRO_TILE_WIDTH;
    uint32_t micro_tile_index_x = x / MICRO_TILE_WIDTH;
    uint32_t micro_tile_index_y = y / MICRO_TILE_HEIGHT;
    uint32_t micro_tile_index_z = slice / MICRO_TILE_THICKNESS;

    uint32_t slice_offset = micro_tile_index_z * slice_bytes;
    uint32_t micro_tile_offset = (micro_tile_index_y * micro_tiles_per_row + micro_tile_index_x) * MICRO_TILE_BYTES;

    uint32_t pixel_index = ComputePixelIndexWithinMicroTile(x, y, slice);

    uint32_t sample_offset;
    uint32_t pixel_offset;
    if (MICRO_TILE_MODE == ADDR_SURF_DEPTH_MICRO_TILING) {
        sample_offset = sample_index * BITS_PER_PIXEL;
        pixel_offset = pixel_index * BITS_PER_PIXEL * NUM_SAMPLES;
    } else {
        sample_offset = sample_index * (MICRO_TILE_BYTES * 8 / NUM_SAMPLES);
        pixel_offset = pixel_index * BITS_PER_PIXEL;
    }

    uint32_t elem_offset = (sample_offset + pixel_offset) / 8;
    return slice_offset + micro_tile_offset + elem_offset;
}

#if IS_MACRO_TILED
uint32_t ComputePipeFromCoord(uint32_t x, uint32_t y, uint32_t slice) {
    uint32_t p0 = 0;
    uint32_t p1 = 0;
    uint32_t p2 = 0;

    uint32_t tx = x / MICRO_TILE_WIDTH;
    uint32_t ty = y / MICRO_TILE_HEIGHT;
    uint32_t x3 = _BIT(tx, 0);
    uint32_t x4 = _BIT(tx, 1);
    uint32_t x5 = _BIT(tx, 2);
    uint32_t y3 = _BIT(ty, 0);
    uint32_t y4 = _BIT(ty, 1);
    uint32_t y5 = _BIT(ty, 2);

    if (PIPE_CONFIG == ADDR_SURF_P2) {
        p0 = x3 ^ y3;
    } else if (PIPE_CONFIG == ADDR_SURF_P8_32x32_8x16) {
        p0 = x4 ^ y3 ^ x5;
        p1 = x3 ^ y4;
        p2 = x5 ^ y5;
    } else if (PIPE_CONFIG == ADDR_SURF_P8_32x32_16x16) {
        p0 = x3 ^ y3 ^ x4;
        p1 = x4 ^ y4;
        p2 = x5 ^ y5;
    }

    uint32_t pipe = p0 | (p1 << 1) | (p2 << 2);

    uint32_t pipe_swizzle = 0;
    if (ARRAY_MODE == ARRAY_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THICK ||
        ARRAY_MODE == ARRAY_3D_TILED_XTHICK) {
        pipe_swizzle += max(1u, NUM_PIPES / 2 - 1) * (slice / MICRO_TILE_THICKNESS);
    }
    pipe_swizzle &= (NUM_PIPES - 1);
    pipe = pipe ^ pipe_swizzle;
    return pipe;
}

uint32_t ComputeBankFromCoord(uint32_t x, uint32_t y, uint32_t slice, uint32_t tile_split_slice) {
    uint32_t b0 = 0;
    uint32_t b1 = 0;
    uint32_t b2 = 0;
    uint32_t b3 = 0;
    uint32_t slice_rotation = 0;
    uint32_t tile_split_rotation = 0;

    uint32_t tx = x / MICRO_TILE_WIDTH / (BANK_WIDTH * NUM_PIPES);
    uint32_t ty = y / MICRO_TILE_HEIGHT / BANK_HEIGHT;

    uint32_t x3 = _BIT(tx, 0);
    uint32_t x4 = _BIT(tx, 1);
    uint32_t x5 = _BIT(tx, 2);
    uint32_t x6 = _BIT(tx, 3);
    uint32_t y3 = _BIT(ty, 0);
    uint32_t y4 = _BIT(ty, 1);
    uint32_t y5 = _BIT(ty, 2);
    uint32_t y6 = _BIT(ty, 3);

    if (NUM_BANKS == 16) {
        b0 = x3 ^ y6;
        b1 = x4 ^ y5 ^ y6;
        b2 = x5 ^ y4;
        b3 = x6 ^ y3;
    } else if (NUM_BANKS == 8) {
        b0 = x3 ^ y5;
        b1 = x4 ^ y4 ^ y5;
        b2 = x5 ^ y3;
    } else if (NUM_BANKS == 4) {
        b0 = x3 ^ y4;
        b1 = x4 ^ y3;
    } else if (NUM_BANKS == 2) {
        b0 = x3 ^ y3;
    }

    uint32_t bank = b0 | (b1 << 1) | (b2 << 2) | (b3 << 3);

    if (ARRAY_MODE == ARRAY_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_2D_TILED_THICK ||
        ARRAY_MODE == ARRAY_2D_TILED_XTHICK) {
        slice_rotation = ((NUM_BANKS / 2) - 1) * (slice / MICRO_TILE_THICKNESS);
    } else if (ARRAY_MODE == ARRAY_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THICK ||
        ARRAY_MODE == ARRAY_3D_TILED_XTHICK) {
        slice_rotation = max(1u, (NUM_PIPES / 2) - 1) * (slice / MICRO_TILE_THICKNESS) / NUM_PIPES;
    }

    if (ARRAY_MODE == ARRAY_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THIN1 ||
        ARRAY_MODE == ARRAY_PRT_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_3D_TILED_THIN1) {
        tile_split_rotation = ((NUM_BANKS / 2) + 1) * tile_split_slice;
    }

    bank ^= info.bank_swizzle + slice_rotation;
    bank ^= tile_split_rotation;
    bank &= (NUM_BANKS - 1);

    return bank;
}

uint32_t ComputeSurfaceAddrFromCoordMacroTiled(uint32_t x, uint32_t y, uint32_t slice, uint32_t pitch, uint32_t height, uint32_t sample_index) {
    uint32_t pixel_index = ComputePixelIndexWithinMicroTile(x, y, slice);

    uint32_t sample_offset;
    uint32_t pixel_offset;
    if (MICRO_TILE_MODE == ADDR_SURF_DEPTH_MICRO_TILING) {
        sample_offset = sample_index * BITS_PER_PIXEL;
        pixel_offset = pixel_index * BITS_PER_PIXEL * NUM_SAMPLES;
    } else {
        sample_offset = sample_index * (MICRO_TILE_BITS / NUM_SAMPLES);
        pixel_offset = pixel_index * BITS_PER_PIXEL;
    }

    uint32_t element_offset = (pixel_offset + sample_offset) / 8;

    uint32_t micro_tile_bytes = MICRO_TILE_BYTES;
    uint32_t slices_per_tile = 1;
    uint32_t tile_split_slice = 0;
    if (MICRO_TILE_BYTES > TILE_SPLIT_BYTES && MICRO_TILE_THICKNESS == 1) {
        slices_per_tile = MICRO_TILE_BYTES / TILE_SPLIT_BYTES;
        tile_split_slice = element_offset / TILE_SPLIT_BYTES;
        element_offset %= TILE_SPLIT_BYTES;
        micro_tile_bytes = TILE_SPLIT_BYTES;
    }

    uint32_t macro_tile_pitch = (MICRO_TILE_WIDTH * BANK_WIDTH * NUM_PIPES) * MACRO_TILE_ASPECT;
    uint32_t macro_tile_height = (MICRO_TILE_HEIGHT * BANK_HEIGHT * NUM_BANKS) / MACRO_TILE_ASPECT;

    uint32_t macro_tile_bytes = micro_tile_bytes *
                               (macro_tile_pitch / MICRO_TILE_WIDTH) *
                               (macro_tile_height / MICRO_TILE_HEIGHT) / (NUM_PIPES * NUM_BANKS);

    uint32_t macro_tiles_per_row = pitch / macro_tile_pitch;

    uint32_t macro_tile_index_x = x / macro_tile_pitch;
    uint32_t macro_tile_index_y = y / macro_tile_height;
    uint32_t macro_tile_offset =
        ((macro_tile_index_y * macro_tiles_per_row) + macro_tile_index_x) * macro_tile_bytes;
    uint32_t macro_tiles_per_slice = macro_tiles_per_row * (height / macro_tile_height);

    uint32_t slice_bytes = macro_tiles_per_slice * macro_tile_bytes;
    uint32_t slice_offset =
        slice_bytes * (tile_split_slice + slices_per_tile * (slice / MICRO_TILE_THICKNESS));

    uint32_t tile_row_index = (y / MICRO_TILE_HEIGHT) % BANK_HEIGHT;
    uint32_t tile_column_index = ((x / MICRO_TILE_WIDTH) / NUM_PIPES) % BANK_WIDTH;
    uint32_t tile_index = (tile_row_index * BANK_WIDTH) + tile_column_index;
    uint32_t tile_offset = tile_index * micro_tile_bytes;

    uint32_t total_offset = slice_offset + macro_tile_offset + element_offset + tile_offset;

    if (ARRAY_MODE == ARRAY_PRT_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_TILED_THICK ||
        ARRAY_MODE == ARRAY_PRT_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_2D_TILED_THICK ||
        ARRAY_MODE == ARRAY_PRT_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_3D_TILED_THICK) {
        x %= macro_tile_pitch;
        y %= macro_tile_height;
    }

    uint32_t pipe = ComputePipeFromCoord(x, y, slice);
    uint32_t bank = ComputeBankFromCoord(x, y, slice, tile_split_slice);

    uint32_t pipe_interleave_mask = (1 << NUM_PIPE_INTERLEAVE_BITS) - 1;
    uint32_t pipe_interleave_offset = total_offset & pipe_interleave_mask;
    uint32_t offset = total_offset >> NUM_PIPE_INTERLEAVE_BITS;

    uint32_t addr = pipe_interleave_offset;
    uint32_t pipe_bits = pipe << NUM_PIPE_INTERLEAVE_BITS;
    uint32_t bank_bits = bank << (NUM_PIPE_INTERLEAVE_BITS + NUM_PIPE_BITS);
    uint32_t offset_bits = offset << (NUM_PIPE_INTERLEAVE_BITS + NUM_PIPE_BITS + NUM_BANK_BITS);

    addr |= pipe_bits;
    addr |= bank_bits;
    addr |= offset_bits;

    return addr;
}
#endif

uint GetMipLevel(inout uint texel) {
    const uint end = min(info.num_mips, 16u);
    for (uint mip = 0; mip < end; ++mip) {
        const uint mip_size = info.mips[mip].size / BYTES_PER_PIXEL;
        if (texel < mip_size) return mip;
        texel -= mip_size;
    }
    return end;
}

uint GetTiledOffset(uint texel) {
    uint mip = GetMipLevel(texel);
    if (mip >= min(info.num_mips, 16u)) return 0xffffffffu;
    uint pitch = info.mips[mip].pitch;
    uint height = info.mips[mip].height;
    uint tiled_offset = info.mips[mip].offset;
    uint x = texel % pitch;
    uint y = (texel / pitch) % height;
    uint slice = texel / (pitch * height);

#if IS_MACRO_TILED
    if ((info.micro_mip_mask & (1u << mip)) != 0) {
        tiled_offset += ComputeSurfaceAddrFromCoordMicroTiled(x, y, slice, pitch, height, 0);
    } else {
        tiled_offset += ComputeSurfaceAddrFromCoordMacroTiled(x, y, slice, pitch, height, 0);
    }
#else
    tiled_offset += ComputeSurfaceAddrFromCoordMicroTiled(x, y, slice, pitch, height, 0);
#endif

    return tiled_offset;
}

#ifdef FROM_IMAGE
// Raw packing of the sampled value (tile_manager.cpp SelectReadbackPack); only the kinds of
// this pixel width are compiled in.
layout(constant_id = 12) const uint PACK_KIND = 0;
layout(constant_id = 13) const uint PACK_BGRA = 0;

// half (5e/10m, bias 15) -> unsigned 11-bit (5e/6m) / 10-bit (5e/5m) float by truncating
// mantissa bits; negative values clamp to zero like the hardware conversion.
uint PackUfloat11(float v) {
    uint h = packHalf2x16(vec2(v, 0.0)) & 0xffffu;
    if ((h & 0x8000u) != 0u) return 0u;
    return (h >> 4u) & 0x7ffu;
}
uint PackUfloat10(float v) {
    uint h = packHalf2x16(vec2(v, 0.0)) & 0xffffu;
    if ((h & 0x8000u) != 0u) return 0u;
    return (h >> 5u) & 0x3ffu;
}
BLOCK_TYPE PackSample(vec4 c) {
#if BITS_PER_PIXEL == 8
    // unorm8 x1 (byte lane, written with atomics below)
    return uint32_t(clamp(c.r, 0.0, 1.0) * 255.0 + 0.5);
#elif BITS_PER_PIXEL == 16
    if (PACK_KIND == 5) {           // unorm8 x2
        return uint16_t(packUnorm4x8(vec4(c.rg, 0.0, 0.0)) & 0xffffu);
    } else if (PACK_KIND == 9) {    // sfloat16 x1
        return uint16_t(packHalf2x16(vec2(c.r, 0.0)) & 0xffffu);
    }
    // unorm16 x1 (also D16)
    return uint16_t(packUnorm2x16(vec2(c.r, 0.0)) & 0xffffu);
#elif BITS_PER_PIXEL == 32
    if (PACK_KIND == 1) {           // unorm8 x4 (rgba / bgra memory order)
        return packUnorm4x8(PACK_BGRA != 0 ? c.bgra : c);
    } else if (PACK_KIND == 3) {    // sfloat32 x1 (also D32)
        return floatBitsToUint(c.r);
    } else if (PACK_KIND == 4) {    // sfloat16 x2
        return packHalf2x16(c.rg);
    } else if (PACK_KIND == 11) {   // unorm16 x2
        return packUnorm2x16(c.rg);
    }
    // B10G11R11 ufloat
    return PackUfloat11(c.r) | (PackUfloat11(c.g) << 11u) | (PackUfloat10(c.b) << 22u);
#elif BITS_PER_PIXEL == 64
    if (PACK_KIND == 2) {           // sfloat16 x4
        return u32vec2(packHalf2x16(c.rg), packHalf2x16(c.ba));
    } else if (PACK_KIND == 7) {    // sfloat32 x2
        return u32vec2(floatBitsToUint(c.r), floatBitsToUint(c.g));
    }
    // unorm16 x4
    return u32vec2(packUnorm2x16(c.rg), packUnorm2x16(c.ba));
#elif BITS_PER_PIXEL == 128
    // sfloat32 x4
    return u32vec4(floatBitsToUint(c.r), floatBitsToUint(c.g), floatBitsToUint(c.b),
                   floatBitsToUint(c.a));
#else
#error "no fused readback packing for this pixel width"
#endif
}
vec4 FetchSample(uint mip, uint x, uint y, uint slice) {
    // Normalised coordinates of the guest texel centre; the sampler maps them onto the
    // scaled backing, so a x0.5 image is upscaled bilinearly (nearest for depth).
    vec2 extent = vec2(float(max(info.native_width >> mip, 1u)),
                       float(max(info.native_height >> mip, 1u)));
    vec2 uv = (vec2(float(x), float(y)) + 0.5) / extent;
    return textureLod(src_image, vec3(uv, float(slice)), float(mip));
}
bool DecodeTexel(uint texel, out uint mip, out uint x, out uint y, out uint slice) {
    mip = GetMipLevel(texel);
    if (mip >= min(info.num_mips, 16u)) return false;
    uint pitch = info.mips[mip].pitch;
    uint height = info.mips[mip].height;
    x = texel % pitch;
    y = (texel / pitch) % height;
    slice = texel / (pitch * height);
    return true;
}
#endif

void main() {
#ifdef FROM_IMAGE
    uint tiled_offset = GetTiledOffset(gl_GlobalInvocationID.x);
    if (tiled_offset == 0xffffffffu) return;
    uint s_mip, s_x, s_y, s_slice;
    if (!DecodeTexel(gl_GlobalInvocationID.x, s_mip, s_x, s_y, s_slice)) return;
    vec4 sample_value = FetchSample(s_mip, s_x, s_y, s_slice);
#if BITS_PER_PIXEL == 8
    uint value = PackSample(sample_value);
    uint shift = (tiled_offset & 3u) * 8u;
    atomicAnd(tiled_data[tiled_offset >> 2u], ~(0xffu << shift));
    atomicOr(tiled_data[tiled_offset >> 2u], value << shift);
#else
    tiled_data[tiled_offset / BYTES_PER_PIXEL] = PackSample(sample_value);
#endif
#elif BITS_PER_PIXEL == 8
    if (IS_TILER != 0) {
        uint tiled_offset = GetTiledOffset(gl_GlobalInvocationID.x);
        if (tiled_offset == 0xffffffffu) return;
        uint linear_index = gl_GlobalInvocationID.x;
        uint value =
            bitfieldExtract(linear_data[linear_index >> 2u], int((linear_index & 3u) * 8u), 8);
        uint shift = (tiled_offset & 3u) * 8u;
        // The tiling map gives each byte a unique writer. Disjoint masks commute;
        // both operations must be atomic to preserve the other three byte lanes.
        atomicAnd(tiled_data[tiled_offset >> 2u], ~(0xffu << shift));
        atomicOr(tiled_data[tiled_offset >> 2u], value << shift);
    } else {
        // One invocation owns an entire output word. Byte stores emulated with
        // non-atomic read/modify/write would lose neighbouring invocations' data.
        uint first = gl_GlobalInvocationID.x * 4u;
        uint packed = 0u;
        for (uint lane = 0u; lane < 4u; ++lane) {
            uint address = GetTiledOffset(first + lane);
            if (address == 0xffffffffu) {
                if (lane == 0u) return;
                break;
            }
            uint value = bitfieldExtract(tiled_data[address >> 2u], int((address & 3u) * 8u), 8);
            packed |= value << (lane * 8u);
        }
        linear_data[gl_GlobalInvocationID.x] = packed;
    }
#else
    uint tiled_offset = GetTiledOffset(gl_GlobalInvocationID.x);
    if (tiled_offset == 0xffffffffu) return;
    if (IS_TILER != 0) {
        tiled_data[tiled_offset / BYTES_PER_PIXEL] = linear_data[gl_GlobalInvocationID.x];
    } else {
        linear_data[gl_GlobalInvocationID.x] = tiled_data[tiled_offset / BYTES_PER_PIXEL];
    }
#endif
}
