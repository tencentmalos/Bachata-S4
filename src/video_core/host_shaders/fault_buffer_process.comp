#version 450

layout(constant_id = 0) const uint CACHING_PAGEBITS = 12;
layout(constant_id = 1) const uint MAX_PAGE_FAULTS = 1024;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer input_buf {
    uint fault_buffer[];
};

layout(std430, binding = 1) buffer output_buf {
    uvec2 download_buffer[];
};
layout(std430, binding = 1) buffer output_buf32 {
    uint download_buffer32[];
};

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id >= fault_buffer.length()) {
        return;
    }
    uint word = fault_buffer[id];
    const uint base_bit = id * 32u;
    while (word != 0u) {
        // Reserve without growing the count beyond the output descriptor. Keep
        // unconsumed bits for the next pass instead of losing overflow faults.
        uint count = atomicAdd(download_buffer32[0], 0u);
        bool reserved = false;
        while (count < MAX_PAGE_FAULTS - 1u) {
            const uint previous = atomicCompSwap(download_buffer32[0], count, count + 1u);
            if (previous == count) {
                reserved = true;
                break;
            }
            count = previous;
        }
        if (!reserved) {
            break;
        }
        const uint bit = findLSB(word);
        word &= word - 1;
        const uint page = base_bit + bit;
        download_buffer[count + 1u] = uvec2(page << CACHING_PAGEBITS, page >> (32 - CACHING_PAGEBITS));
    }
    fault_buffer[id] = word;
}
