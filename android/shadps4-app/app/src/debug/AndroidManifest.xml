<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reads .zar game archives from a user-chosen folder (Settings > Game Library).
         Scoped storage has no path-based read for non-media files, and the native loader
         opens archives by path. Debug builds only; see app/src/fdroid for the shipped one. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android's GPU debug layer lookup (gpu_debug_layer_app) runs in this app's package
         context: without visibility of the RenderDoc package the layer is "not installed",
         and a forced layer then fails every vkCreateInstance, including HWUI's. -->
    <queries>
        <package android:name="com.picoxr.renderdoccmd.arm64" />
        <package android:name="org.renderdoc.renderdoccmd.arm64" />
    </queries>
    <application>
        <activity android:name=".RuntimeValidationActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
