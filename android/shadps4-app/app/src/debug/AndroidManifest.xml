<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reads .zar game archives from a user-chosen folder (Settings > Game Library).
         Scoped storage has no path-based read for non-media files, and the native loader
         opens archives by path. Debug builds only; see app/src/fdroid for the shipped one. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application>
        <activity android:name=".RuntimeValidationActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
