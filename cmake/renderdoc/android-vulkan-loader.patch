diff --git a/renderdoc/driver/vulkan/vk_android.cpp b/renderdoc/driver/vulkan/vk_android.cpp
index 794eb389f..b7ba218ba 100644
--- a/renderdoc/driver/vulkan/vk_android.cpp
+++ b/renderdoc/driver/vulkan/vk_android.cpp
@@ -23,6 +23,7 @@
  ******************************************************************************/
 
 #include <android/native_window.h>
+#include <sys/system_properties.h>
 #include "vk_core.h"
 #include "vk_replay.h"
 
@@ -109,5 +110,20 @@ void VulkanReplay::GetOutputWindowDimensions(uint64_t id, int32_t &w, int32_t &h
 
 void *LoadVulkanLibrary()
 {
+  // Optional replay loader (e.g. adrenotools + a pinned bionic Turnip). The
+  // factory returns a Vulkan loader handle, not a raw ICD or a replacement GIPA.
+  // An explicitly requested loader must fail closed, never use the system ICD.
+  char path[PROP_VALUE_MAX] = {};
+  if(__system_property_get("debug.rdoc.vulkan_loader", path) > 0)
+  {
+    void *module = Process::LoadModule(path);
+    using Factory = void *(*)();
+    Factory factory = module ? (Factory)Process::GetFunctionAddress(module, "RenderDoc_LoadAndroidVulkan") : NULL;
+    void *loader = factory ? factory() : NULL;
+    if(!loader)
+      RDCERR("Requested Android Vulkan loader failed: %s; system fallback disabled", path);
+    // Keep both the factory and its namespace alive until process exit.
+    return loader;
+  }
   return Process::LoadModule("libvulkan.so");
 }
