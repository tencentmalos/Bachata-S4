+    VKAPI_ATTR void VKAPI_CALL HookCmdDispatchIndirect(VkCommandBuffer commandBuffer,
+        VkBuffer buffer, VkDeviceSize offset) {
+        GrsAndroidSdk* sdk = GrsAndroidGetActiveSdk();
+        if (!sdk) return;
+        const auto next = Next<PFN_vkCmdDispatchIndirect>(sdk, sdk->attachedDevice, "vkCmdDispatchIndirect");
+        if (!next) return;
+        try {
+            ApplyBoundInstrumentation(sdk, commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE);
+        } catch (...) {
+        }
+        next(commandBuffer, buffer, offset);
+        // Group counts are GPU data. Do not invent a direct-dispatch event with
+        // zero counts; the actual instrumented submission supplies GPU evidence.
+    }
