#!/usr/bin/env python3
"""Verify the pinned Android driver and generate APK assets. No tracked binaries."""
import argparse
import hashlib
import io
import json
from pathlib import Path
import tempfile
import urllib.request
import zipfile

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--archive", type=Path)
    args = parser.parse_args()
    lock = json.loads((ROOT / "runtime/locks/turnip-bionic.json").read_text())
    cache = args.archive or ROOT / "build/drivers" / (lock["archive_sha256"] + ".zip")
    if not cache.exists():
        if args.archive:
            raise ValueError("Specified driver archive does not exist")
        request = urllib.request.Request(lock["url"], headers={"User-Agent": "shadps4-build"})
        with urllib.request.urlopen(request, timeout=90) as response:
            archive = response.read(32 * 1024 * 1024 + 1)
    else:
        archive = cache.read_bytes()
    if hashlib.sha256(archive).hexdigest() != lock["archive_sha256"]:
        raise ValueError("Turnip archive SHA256 mismatch")
    with zipfile.ZipFile(io.BytesIO(archive)) as source:
        if source.namelist().count(lock["library"]) != 1:
            raise ValueError("Missing or duplicate Turnip ELF")
        library = source.read(lock["library"])
    if hashlib.sha256(library).hexdigest() != lock["library_sha256"]:
        raise ValueError("Turnip ELF SHA256 mismatch")
    if library[:5] != b"\x7fELF\x02" or int.from_bytes(library[18:20], "little") != 183:
        raise ValueError("Turnip must be ELF64 AArch64")
    cache.parent.mkdir(parents=True, exist_ok=True)
    if not cache.exists():
        atomic_write(cache, archive)
    args.out.mkdir(parents=True, exist_ok=True)
    atomic_write(args.out / lock["library"], library)
    atomic_write(args.out / "identity.json", (json.dumps(lock, indent=2) + "\n").encode())
    print("TURNIP_ASSETS_PASS " + lock["library_sha256"])


def atomic_write(path, data):
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
        temp = Path(output.name)
        try:
            output.write(data)
            output.flush()
            temp.chmod(0o644)
            temp.replace(path)
        finally:
            temp.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
