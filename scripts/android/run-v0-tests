"""Run the V0 host suites and emit the acceptance-matrix results JSON.

This deliberately does not invent results. Every case in the acceptance matrix
starts as NOT_RUN and is only promoted by a suite that actually executed. Cases
that need a device, or that need the FEX backend, stay NOT_RUN with the reason
recorded.

Usage:
  scripts/android/run-v0-tests [--build-dir DIR] [--serial SERIAL]
                               [--expected-page-size N] [--out FILE]
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]

# Every case in docs/specs/android-fex-v0-acceptance.md, with why it cannot run
