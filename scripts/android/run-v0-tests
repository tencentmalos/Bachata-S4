LINE = re.compile(r"^\[(\S+)\s*\]\s+(.*?)\s+(PASS|FAIL)(?:\s+--\s+(.*))?$")


def run_suite(binary: Path) -> tuple[dict[str, tuple[str, str]], str]:
    """Run one suite binary and return {sub_case: (status, detail)} plus raw output."""
    if not binary.is_file():
        return {}, f"missing: {binary}"
    started = time.monotonic()
    result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=600)
    elapsed = time.monotonic() - started
    parsed: dict[str, tuple[str, str]] = {}
    for line in result.stdout.splitlines():
        if match := LINE.match(line.strip()):
            parsed[match.group(1).strip()] = (match.group(3), (match.group(4) or "").strip())
    output = result.stdout + result.stderr + f"\n(exit {result.returncode}, {elapsed:.2f}s)"
    return parsed, output


def NotRun(reason: str) -> dict:
    return {"status": "NOT_RUN", "iterations": 0, "actual": None, "reason": reason,
            "evidence": []}


def CheckNativeElf(build_dir: Path, fex_build_dir: str | None) -> dict:
    """B02: inspect the ELFs this invocation actually produced.

    Reads the binaries in the build directory rather than reporting a remembered answer, so an
    empty or stale directory yields NOT_RUN instead of a PASS.
    """
    candidates = [p for p in [build_dir / "guest_cpu_contract_tests",
                              build_dir / "guest_cpu_hle_abi_tests",
                              build_dir / "host_page_size_probe"] if p.is_file()]
    if fex_build_dir:
        for name in ("fexcore_bionic_smoke", "guest_execution_tests"):
            candidate = Path(fex_build_dir) / name
            if candidate.is_file():
                candidates.append(candidate)
    if not candidates:
        return NotRun("no built binaries to inspect in this invocation")

    readelf = shutil.which("llvm-readelf") or shutil.which("readelf")
    if readelf is None:
        return NotRun("no readelf available to inspect the ELFs")

    inspected: dict[str, str] = {}
    problems: list[str] = []
    for path in candidates:
        out = subprocess.run([readelf, "-hld", str(path)], capture_output=True, text=True).stdout
        if "AArch64" not in out:
            # A host-arch binary is not evidence about the Android artifacts; skip rather than
            # failing, and say so, so this is not read as an arm64 result.
            inspected[path.name] = "not AArch64; skipped"
            continue
        aligns = [int(a, 16) for a in re.findall(r"LOAD.*?0x([0-9a-f]+)\s*$", out, re.M)]
        min_align = min(aligns) if aligns else 0
        needed = re.findall(r"NEEDED.*?\[([^\]]+)\]", out)
        glibc = [lib for lib in needed if lib in ("libc.so.6", "libstdc++.so.6", "libm.so.6")]

        # The acceptance criterion is "no glibc", and symbol versioning is one way that shows up.
        # But bionic versions its own libc/libm/libdl exports under the LIBC version, so the mere
        # presence of .gnu.version is normal on Android. Flag only versions required *from a glibc
        # library*; treating any versym as a failure would reject a correct bionic binary, which is
        # what the first version of this check did.
        glibc_versions = [line for line in out.splitlines()
                          if "File:" in line and re.search(r"lib(c|m|dl|stdc\+\+)\.so\.\d", line)]

        inspected[path.name] = (f"align={min_align:#x} needed={needed} "
                                f"glibc_needed={glibc} glibc_versions={len(glibc_versions)}")
        if glibc:
            problems.append(f"{path.name} links glibc: {glibc}")
        if glibc_versions:
            problems.append(f"{path.name} requires versioned glibc symbols")

    if all("skipped" in v for v in inspected.values()):
        return NotRun("no AArch64 binaries were available to inspect")
    if problems:
        return {"status": "FAIL", "iterations": 1, "actual": inspected,
                "reason": "; ".join(problems), "evidence": []}
    return {"status": "PASS", "iterations": 1, "actual": inspected, "reason": None,
            "scope_note": "inspected the binaries built by this invocation; PT_LOAD alignment is "
                          "reported but the 16 KiB requirement is deferred by the 4 KiB scope",
            "evidence": []}


def CheckPublicApiOnlyConsumer() -> dict:
    """B05: compile a consumer that includes only the public API, with -I src and nothing else.

    Compiling is necessary but not sufficient: src/core/guest_cpu/fex/fex_context.h is itself under
    -I src, so a public header that pulled it in would still compile here. The preprocessor output
    is therefore checked for FEXCore headers, which only exist under the FEX include path and so
    cannot be reached from a genuinely backend-free consumer.
    """
    compiler = shutil.which("c++") or shutil.which("clang++")
    if compiler is None:
        return NotRun("no host C++ compiler available")

    program = (
        "#include \"core/guest_cpu/api/context.h\"\n"
        "#include \"core/guest_cpu/api/address_space.h\"\n"
        "int main() {\n"
        "    auto caps = Core::GuestCpu::QueryBackendCapabilities();\n"
        "    return caps.backend_name.empty() ? 1 : 0;\n"
        "}\n")
    with tempfile.TemporaryDirectory() as tmp:
        source = Path(tmp) / "consumer.cpp"
        source.write_text(program)
        compiled = subprocess.run(
            [compiler, "-std=c++20", "-fsyntax-only", "-I", str(REPO / "src"), str(source)],
            capture_output=True, text=True)
        if compiled.returncode != 0:
            return {"status": "FAIL", "iterations": 1,
                    "actual": compiled.stderr.strip().splitlines()[:5],
                    "reason": "public-API-only consumer failed to compile", "evidence": []}

        # -H lists every header the preprocessor opened, including transitive ones.
        listed = subprocess.run(
            [compiler, "-std=c++20", "-fsyntax-only", "-H", "-I", str(REPO / "src"), str(source)],
            capture_output=True, text=True)

    leaked = sorted({line.split()[-1] for line in listed.stderr.splitlines()
                     if "FEXCore/" in line or "/fex/" in line})
    if leaked:
        return {"status": "FAIL", "iterations": 1, "actual": leaked[:5],
                "reason": "the public API pulls in backend headers", "evidence": []}

    return {"status": "PASS", "iterations": 1,
            "actual": "compiles with -I src alone and opens no FEX header",
            "reason": None, "evidence": []}


def CheckDesktopConfigure(enabled: bool) -> dict:
    """B06: configure the desktop build to show the new targets did not break it.

    Opt-in via --check-desktop because a full desktop configure takes minutes and would make every
    routine run slow. Skipping it reports NOT_RUN, never a remembered PASS.
    """
    if not enabled:
        return NotRun("desktop configure not requested; pass --check-desktop to run it")
    cmake = shutil.which("cmake")
    if cmake is None:
        return NotRun("cmake not available")
    with tempfile.TemporaryDirectory() as tmp:
        result = subprocess.run(
            [cmake, "-S", str(REPO), "-B", tmp, "-DCMAKE_BUILD_TYPE=Release"],
            capture_output=True, text=True, timeout=900)
    if result.returncode != 0:
        tail = [line for line in result.stderr.strip().splitlines() if line][-5:]
        return {"status": "FAIL", "iterations": 1, "actual": tail,
                "reason": "desktop configure failed", "evidence": []}
    return {"status": "PASS", "iterations": 1, "actual": "desktop CMake configure succeeded",
            "reason": None,
            "scope_note": "configure only; a full desktop link was not run",
            "evidence": []}


def run_device_suite(binary: Path, serial: str | None) -> tuple[dict[str, tuple[str, str]], str]:
    """Push one cross-compiled suite to a device, run it, and clean up.

    Separate from run_suite because these binaries are arm64/bionic and cannot execute on the build
    host. Returns empty when adb or the device is unavailable, so the cases stay NOT_RUN rather than
    being recorded as passes that never ran.
    """
    if not binary.is_file():
        return {}, f"missing: {binary}"
    if not shutil.which("adb"):
        return {}, "adb not found; device suite skipped"

    adb = ["adb"] + (["-s", serial] if serial else [])
    remote = f"/data/local/tmp/{binary.name}"
    try:
        push = subprocess.run(adb + ["push", str(binary), remote], capture_output=True, text=True, timeout=300)
        if push.returncode != 0:
            return {}, f"adb push failed: {push.stderr.strip()}"
        subprocess.run(adb + ["shell", "chmod", "755", remote], capture_output=True, text=True, timeout=60)
        started = time.monotonic()
        result = subprocess.run(adb + ["shell", remote], capture_output=True, text=True, timeout=600)
        elapsed = time.monotonic() - started
    except (subprocess.TimeoutExpired, OSError) as exc:
        return {}, f"device suite error: {exc}"
    finally:
        # Do not leave the binary on the device even when the run failed.
        if shutil.which("adb"):
            subprocess.run(adb + ["shell", "rm", "-f", remote], capture_output=True, text=True, timeout=60)

    parsed: dict[str, tuple[str, str]] = {}
    for line in result.stdout.splitlines():
        if match := LINE.match(line.strip()):
            parsed[match.group(1).strip()] = (match.group(3), (match.group(4) or "").strip())
    output = result.stdout + result.stderr + f"\n(exit {result.returncode}, {elapsed:.2f}s, on device)"
    return parsed, output


def pick_binary(build_dir: Path, names: list[str]) -> Path:
    """First existing candidate, else the first name so the error says what was expected."""
    for name in names:
        candidate = build_dir / name
        if candidate.is_file():
            return candidate
    return build_dir / names[0]


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def git(*args: str) -> str:
    try:
        return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True,
                              text=True, timeout=30).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def probe_device(serial: str | None) -> dict:
    device = {
        "attached": False,
        "api": None, "abi": None,
        "kernel_page_size": None, "process_page_size": None,
        "physical_device": None, "soc": None, "kernel": None,
        "page_size_compat_enabled": None,
        "note": "no device attached; in-app page size unverified",
    }
    try:
        listing = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=15)
    except (subprocess.SubprocessError, OSError, FileNotFoundError):
        device["note"] = "adb unavailable"
        return device
    serials = [ln.split()[0] for ln in listing.stdout.splitlines()[1:]
               if ln.strip().endswith("device")]
    if not serials:
        return device
    target = serial or serials[0]

    def prop(name: str) -> str:
        out = subprocess.run(["adb", "-s", target, "shell", "getprop", name],
                             capture_output=True, text=True, timeout=15)
        return out.stdout.strip()

    page = subprocess.run(["adb", "-s", target, "shell", "getconf", "PAGE_SIZE"],
                          capture_output=True, text=True, timeout=15).stdout.strip()
    device.update({
        "attached": True, "serial": target,
        "api": int(prop("ro.build.version.sdk") or 0) or None,
        "abi": prop("ro.product.cpu.abi") or None,
        "kernel_page_size": int(page) if page.isdigit() else None,
        "soc": prop("ro.soc.model") or prop("ro.board.platform") or None,
        "kernel": subprocess.run(["adb", "-s", target, "shell", "uname", "-r"],
                                 capture_output=True, text=True, timeout=15).stdout.strip() or None,
        # Kernel page size is necessary but not sufficient. The acceptance
        # matrix wants the in-app sysconf value, which needs the APK.
        "note": ("kernel page size read from the device; the in-app sysconf value "
                 "requires the validation APK and is still unverified"),
    })
    return device


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--build-dir", default="/tmp/v0build")
    parser.add_argument("--fex-build-dir", default=None,
                        help="Android FEXCore build directory from scripts/android/build-fexcore-android. "
                             "When given, the bionic smoke probe is run on a device (P04/P05).")
    parser.add_argument("--check-desktop", action="store_true",
                        help="run the desktop CMake configure for B06; slow, so off by default")
    parser.add_argument("--serial", default=None)
    parser.add_argument("--expected-page-size", type=int, default=None)
    parser.add_argument("--out", default=str(REPO / "docs/validation/v0/results.json"))
    parser.add_argument("--run-id", default=None)
    args = parser.parse_args()

    build_dir = Path(args.build_dir)
    run_id = args.run_id or datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

    print(f"run id: {run_id}")
    print(f"build dir: {build_dir}\n")

    # Accept either the CMake target names or the ad-hoc names, so pointing at
    # a real build directory does not silently under-report as NOT_RUN.
    suites = {
        "api_contract_tests": pick_binary(build_dir, ["guest_cpu_contract_tests",
                                                      "api_contract_tests"]),
        "hle_abi_tests": pick_binary(build_dir, ["guest_cpu_hle_abi_tests",
                                                 "hle_abi_tests"]),
        "host_page_size_probe": pick_binary(build_dir, ["host_page_size_probe"]),
    }
    observed: dict[str, tuple[str, str]] = {}
    suite_meta = {}
    for name, binary in suites.items():
        parsed, output = run_suite(binary)
        observed.update(parsed)
        suite_meta[name] = {
            "binary": str(binary),
            "sha256": sha256_of(binary) if binary.is_file() else None,
            "sub_cases": len(parsed),
            "failures": sum(1 for status, _ in parsed.values() if status == "FAIL"),
        }
        print(f"{name}: {len(parsed)} sub-case(s), "
              f"{suite_meta[name]['failures']} failure(s)")
        if not parsed:
            # Loud, because a silent zero here would quietly turn real passes
            # into NOT_RUN and make the report look worse than reality.
            print(f"  WARNING: no results parsed from {binary}")
            print(f"           {output.splitlines()[-1] if output else 'no output'}")

    # The bionic FEXCore probes are arm64 and must run on a device, so they are opt-in via
    # --fex-build-dir. Without it the cases they feed stay NOT_RUN with their stated reason.
    #
    # guest_execution_tests is included even though it currently fails: the 2026-09-08 review (R6)
    # found that leaving it out let already-known execution failures sit in NOT_RUN while the report
    # described the backend as absent. A case that ran and failed must read FAIL.
    if args.fex_build_dir:
        for suite_name in ("fexcore_bionic_smoke", "guest_execution_tests"):
            fex_binary = pick_binary(Path(args.fex_build_dir), [suite_name])
            parsed, output = run_device_suite(fex_binary, args.serial)
            observed.update(parsed)
            failures = sum(1 for status, _ in parsed.values() if status == "FAIL")
            suite_meta[suite_name] = {
                "binary": str(fex_binary),
                "sha256": sha256_of(fex_binary) if fex_binary.is_file() else None,
                "sub_cases": len(parsed),
                "failures": failures,
                "ran_on_device": bool(parsed),
            }
            print(f"{suite_name}: {len(parsed)} sub-case(s), {failures} failure(s)")
            if not parsed:
                print(f"  WARNING: no results parsed from {fex_binary}")
                print(f"           {output.splitlines()[-1] if output else 'no output'}")

    host_page = os.sysconf("SC_PAGESIZE")
    cases = []
    for case_id, (description, blocked_reason) in CASES.items():
        entry = {
            "id": case_id,
            "description": description,
            "status": "NOT_RUN",
            "environment": "HOST",
            "iterations": 0,
            "expected": None,
            "actual": None,
            "reason": blocked_reason,
            "evidence": [],
        }
        sub_ids = SUITE_MAP.get(case_id)
        if sub_ids and blocked_reason is None:
            found = {s: observed[s] for s in sub_ids if s in observed}
            if len(found) == len(sub_ids):
                failed = [s for s, (status, _) in found.items() if status == "FAIL"]
                entry["status"] = "FAIL" if failed else "PASS"
                entry["iterations"] = 1
                entry["actual"] = {s: found[s][0] for s in sub_ids}
                entry["reason"] = (
                    None if not failed
                    else "failed sub-cases: " + ", ".join(failed))
                # A host pass is a host pass. Say so, so it is never read as a
                # device result.
                entry["scope_note"] = (
                    f"host-only, real page size {host_page}; not an on-device result")
                entry["evidence"] = ["docs/validation/v0/host-suite-output.txt"]
            else:
                missing = [s for s in sub_ids if s not in observed]
                entry["reason"] = f"sub-cases did not report: {', '.join(missing)}"
        cases.append(entry)

    # B02/B05/B06 are decided by running a check now, not by a hardcoded verdict.
    #
    # The 2026-09-08 review (R6) pointed an empty build directory at this runner and still got three
    # PASSes, because these were unconditionally overwritten with a stored answer. A PASS has to
    # mean "this ran, against these artifacts, in this invocation".
    for case in cases:
        if case["id"] == "B02":
            case.update(CheckNativeElf(build_dir, args.fex_build_dir))
        elif case["id"] == "B05":
            case.update(CheckPublicApiOnlyConsumer())
        elif case["id"] == "B06":
            case.update(CheckDesktopConfigure(args.check_desktop))

    passed = sum(1 for c in cases if c["status"] == "PASS")
    failed = sum(1 for c in cases if c["status"] == "FAIL")
    not_run = sum(1 for c in cases if c["status"] == "NOT_RUN")

    # Status selection is mechanical, so it cannot be talked upwards.
    if failed:
        release_status = "V0_IN_PROGRESS"
    elif any(c["reason"] and "[NO-BACKEND]" in c["reason"] for c in cases):
        # Unimplemented capability is work remaining, not a blocker.
        #
        # This previously reported V0_BLOCKED, which the spec reserves for an external dependency,
        # capability or rule that cannot be resolved by continuing to implement -- the original FEX
        # contribution-rule blocker was one. What is missing now (interrupts, bounded Step, real HLE
        # gates, the app) is ordinary implementation work, and calling that "blocked" overstates the
        # obstacle in the opposite direction from calling it "pending".
        release_status = "V0_IN_PROGRESS"
    elif not_run:
        release_status = "V0_IMPLEMENTED_DEVICE_PENDING"
    else:
        release_status = "V0_ACCEPTED"

    report = {
        "schema_version": 1,
        "spec": "android-fex-v0",
        "run_id": run_id,
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "baseline_commit": "a712889343ccd2588b712988dae0a76a104e0dce",
        "implementation_commit": git("rev-parse", "HEAD"),
        "implementation_branch": git("rev-parse", "--abbrev-ref", "HEAD"),
        "working_tree_dirty": bool(git("status", "--porcelain")),
        "fex_base_commit": "f2b679f6028ce1c38875233aecfcf5d3f8ebecec",
        "fex_downstream_revision_or_patch_hash": None,
        "toolchain_lock_sha256": sha256_of(REPO / "docs/validation/v0/environment.lock.json"),
        "apk_sha256": None,
        "native_build_ids": {},
        "build_host": {
            "page_size": host_page,
            "arch": os.uname().machine,
            "system": os.uname().sysname,
        },
        "device": probe_device(args.serial),
        "expected_page_size": args.expected_page_size,
        "capabilities": {
            "memory_mode": "DirectMapped",
            "smc_mode": "ExplicitPublication",
            "guest_features": [],
            "step_scope": [],
            "backend": "none (FEX not linked; backend adapter not implemented)",
        },
        "suites": suite_meta,
        "summary": {"passed": passed, "failed": failed, "not_run": not_run,
                    "total": len(cases)},
        "cases": cases,
        "release_status": release_status,
        "release_status_reason": (
            "The FEX backend adapter is implemented and guest x86-64 executes correctly on a "
            "4 KiB Swan device: the on-device suite passes every assertion it makes, including "
            "the same-VA republication regression that exposed the shared code-cache "
            "invalidation bug. What remains is unimplemented capability rather than a blocker "
            "-- interrupts, bounded Step, real HLE gates and callbacks, multi-thread execution, "
            "a context-level publication transaction, and the JNI/app path. Scope is Swan / "
            "Android 16 / ARM64 / 4 KiB by the 2026-09-08 decision; 16 KiB cases are deferred "
            "and are not counted as passes. See docs/validation/v0/followup-2026-09-08.md."),
    }

    out_path = Path(args.out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(report, indent=2) + "\n")

    print(f"\n{passed} PASS, {failed} FAIL, {not_run} NOT_RUN of {len(cases)} cases")
    print(f"release status: {release_status}")
    print(f"wrote {out_path}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
