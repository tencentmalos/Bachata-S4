def sub_cases_owned_by(suite_name: str) -> set[str]:
    """Every SUITE_MAP sub-case id that `suite_name` is responsible for producing."""
    prefixes = SUITE_OWNERSHIP.get(suite_name, ())
    if not prefixes:
        return set()
    owned = set()
    for sub_ids in SUITE_MAP.values():
        for sub in sub_ids:
            if sub.startswith(prefixes):
                owned.add(sub)
    return owned



class SuiteRun:
    """One suite execution: its parsed sub-cases plus how the process itself ended.

    The process outcome is carried alongside the parsed lines because a suite can print PASS for
    every check and still fail -- crash during teardown, abort after the last case, exit non-zero
    for a reason it never printed. The 2026-09-08 publication review demonstrated this with a suite
    that printed three PASSes and exited 7, which the runner recorded as M01 PASS (P1-D). A suite
    that did not exit cleanly cannot promote anything.
    """

    def __init__(self, cases=None, output="", exit_code=None, timed_out=False, error=None,
                 never_started=False, iteration_counts=None, conflicts=None):
        self.cases = cases or {}
        self.output = output
        self.exit_code = exit_code
        self.timed_out = timed_out
        self.error = error
        # True when the process was never launched at all -- no binary, no device. That is a
        # genuine "not attempted", distinct from a suite that started and then died, which is a
        # failure. Conflating them would either hide crashes or invent failures for suites that
        # were simply not built.
        self.never_started = never_started
        # How many times each sub-case ID was printed, so a repeated ID carries iteration identity
        # instead of silently collapsing to whichever line came last.
        self.iteration_counts = iteration_counts or {}
        # Sub-cases that reported different verdicts across their repeats.
        self.conflicts = conflicts or []

    @property
    def usable(self) -> bool:
        """True only when the process ran to completion and reported success."""
        return not self.timed_out and self.error is None and self.exit_code == 0

    def failure_reason(self) -> str | None:
        if self.timed_out:
            return "suite timed out"
        if self.error is not None:
            return self.error
        if self.exit_code not in (None, 0):
            return f"suite exited {self.exit_code} despite its printed results"
        return None


def parse_sub_cases(text: str) -> tuple[dict[str, tuple[str, str]], dict[str, int], list[str]]:
    """Parse `[ID] name VERDICT` lines, resolving repeats rather than letting the last one win.

    A sub-case ID can legitimately appear more than once -- a suite may run a case for several
    iterations -- but assigning into a dict made the final line the verdict, so a case that failed
    on iteration 3 and passed on iteration 4 reported PASS. Round 2 R2-B02 requires that a FAIL or
    TIMEOUT is never overwritten by a later PASS and that repeats carry an iteration count.

    Returns (verdicts, iteration counts, conflict descriptions).
    """
    verdicts: dict[str, tuple[str, str]] = {}
    counts: dict[str, int] = {}
    conflicts: list[str] = []
    # Worst verdict wins: a case that ever failed, failed.
    severity = {"PASS": 0, "SKIP": 1, "FAIL": 2}
    for line in text.splitlines():
        match = LINE.match(line.strip())
        if not match:
            continue
        case_id = match.group(1).strip()
        verdict = match.group(3)
        detail = (match.group(4) or "").strip()
        counts[case_id] = counts.get(case_id, 0) + 1
        previous = verdicts.get(case_id)
        if previous is None:
            verdicts[case_id] = (verdict, detail)
            continue
        if previous[0] != verdict:
            conflicts.append(f"{case_id}: reported {previous[0]} then {verdict}")
        if severity.get(verdict, 0) > severity.get(previous[0], 0):
            verdicts[case_id] = (verdict, detail)
    # A PASS summary cannot replace the required per-iteration evidence.
    for case_id, prefix, label, total in (("G25a", "EPOCH ", "G25", 100),
                                          ("G26a", "EPOCH ", "G26", 100),
                                          ("G27a", "STORE ", None, 10)):
        if verdicts.get(case_id, (None,))[0] != "PASS":
            continue
        records = []
        malformed = False
        for line in text.splitlines():
            if not line.startswith(prefix):
                continue
            try:
                record = json.loads(line[len(prefix):])
                if not isinstance(record, dict) or type(record.get("epoch")) is not int:
                    malformed = True
                    continue
                if label is None or record.get("case") == label:
                    records.append(record)
            except (ValueError, TypeError):
                malformed = True
        if (malformed or sorted(record.get("epoch", -1) for record in records) != list(range(total))
                or any(record.get("ok") is not True for record in records)):
            verdicts[case_id] = ("FAIL", f"missing, duplicate, failed or malformed {total}-epoch evidence")
    return verdicts, counts, conflicts


def run_suite(binary: Path) -> SuiteRun:
    """Run one suite binary and report both its sub-cases and its process outcome."""
    if not binary.is_file():
        return SuiteRun(error=f"missing: {binary}", never_started=True)
    started = time.monotonic()
    try:
        result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        return SuiteRun(output=f"timed out after 600s: {binary}", timed_out=True)
    elapsed = time.monotonic() - started
    parsed, counts, conflicts = parse_sub_cases(result.stdout)
    output = result.stdout + result.stderr + f"\n(exit {result.returncode}, {elapsed:.2f}s)"
    return SuiteRun(cases=parsed, output=output, exit_code=result.returncode,
                    iteration_counts=counts, conflicts=conflicts)


def NotRun(reason: str) -> dict:
    return {"status": "NOT_RUN", "iterations": 0, "actual": None, "reason": reason,
            "evidence": []}


def CheckNativeElf(build_dir: Path, fex_build_dir: str | None, apk: str | None) -> dict:
    """B02: the native artifacts this invocation produced are arm64 bionic with a closed dependency set.

    Delegates to scripts/android/verify-native-artifacts so the runner and the app build use one
    implementation rather than two that drift.

    B02's criterion is about the shipped package. Without an APK this can only inspect standalone
    probe ELFs, which the round 1 closeout identified as auxiliary evidence that was being reported
    as a full PASS: the old inline check walked two probes, computed PT_LOAD alignment without ever
    rejecting on it, and never looked at an APK. Auxiliary coverage is now recorded as such and the
    case stays NOT_RUN until a package is available.
    """
    verifier = REPO / "scripts/android/verify-native-artifacts"
    if not verifier.is_file():
        return NotRun("scripts/android/verify-native-artifacts is missing")

    command = [sys.executable, str(verifier)]
    # 16 KiB ELF alignment is a link-time flag this project already sets, and keeping it is a Round
    # 2 requirement even though 16 KiB *host page* support is deferred. Judge it rather than print
    # it: the previous check reported the number and passed regardless.
    command += ["--min-load-align", "0x4000"]
    if apk:
        command += ["--apk", apk]
    for name in ("guest_cpu_contract_tests", "guest_cpu_hle_abi_tests", "host_page_size_probe"):
        candidate = build_dir / name
        if candidate.is_file():
            command += ["--elf", str(candidate)]
    if fex_build_dir:
        for name in ("fexcore_bionic_smoke", "guest_execution_tests", "guest_cpu_contract_tests"):
            candidate = Path(fex_build_dir) / name
            if candidate.is_file():
                command += ["--elf", str(candidate)]

    if "--elf" not in command and "--apk" not in command:
        return NotRun("no built artifacts to inspect in this invocation")

    result = subprocess.run(command, capture_output=True, text=True)
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError:
        return {"status": "FAIL", "iterations": 1,
                "actual": (result.stderr or result.stdout).strip().splitlines()[-5:],
                "reason": "artifact verifier produced no usable report", "evidence": []}

    summary = {
        "coverage": report.get("coverage"),
        "checked": (report.get("package") or report.get("standalone") or {}).get("checked_count"),
    }
    if report.get("standalone"):
        summary["standalone"] = [
            f"{i.get('name')} align={i.get('min_load_align')} needed={i.get('needed')}"
            for i in report["standalone"].get("inspected", []) if i.get("is_aarch64")]
    if report.get("package"):
        summary["apk_sha256"] = report["package"].get("apk_sha256")

    if report["status"] == "FAIL":
        return {"status": "FAIL", "iterations": 1, "actual": summary,
                "reason": report.get("reason"), "evidence": []}
    if report["status"] == "NOT_RUN":
        return NotRun(report.get("reason") or "artifact verification did not run")

    if report.get("coverage") != "package":
        # Real evidence, wrong scope. B02 asks about every native library in the package.
        return {"status": "NOT_RUN", "auxiliary_status": "PASS", "iterations": 1,
                "actual": summary,
                "reason": "full acceptance pending: standalone probe ELFs only; B02 requires every "
                          "native library in the APK, its dependency closure and ZIP layout",
                "scope_note": "auxiliary: arm64/bionic/no-glibc/16 KiB-alignment verified for the "
                              "standalone binaries this invocation built",
                "evidence": []}

    return {"status": "PASS", "iterations": 1, "actual": summary, "reason": None,
            "scope_note": "package coverage: every native library in the APK",
            "evidence": []}


def CheckPublicApiOnlyConsumer() -> dict:
    """B05: compile a consumer that includes only the public API, with -I src and nothing else.

    Compiling is necessary but not sufficient: src/core/guest_cpu/fex/fex_context.h is itself under
    -I src, so a public header that pulled it in would still compile here. The preprocessor output
    is therefore checked for FEXCore headers, which only exist under the FEX include path and so
    cannot be reached from a genuinely backend-free consumer.
    """
    compiler = shutil.which("c++") or shutil.which("clang++")
    if compiler is None:
        return NotRun("no host C++ compiler available")

    program = (
        "#include \"core/guest_cpu/api/context.h\"\n"
        "#include \"core/guest_cpu/api/address_space.h\"\n"
        "int main() {\n"
        "    auto caps = Core::GuestCpu::QueryBackendCapabilities();\n"
        "    return caps.backend_name.empty() ? 1 : 0;\n"
        "}\n")
    with tempfile.TemporaryDirectory() as tmp:
        source = Path(tmp) / "consumer.cpp"
        source.write_text(program)
        compiled = subprocess.run(
            [compiler, "-std=c++20", "-fsyntax-only", "-I", str(REPO / "src"), str(source)],
            capture_output=True, text=True)
        if compiled.returncode != 0:
            return {"status": "FAIL", "iterations": 1,
                    "actual": compiled.stderr.strip().splitlines()[:5],
                    "reason": "public-API-only consumer failed to compile", "evidence": []}

        # -H lists every header the preprocessor opened, including transitive ones.
        listed = subprocess.run(
            [compiler, "-std=c++20", "-fsyntax-only", "-H", "-I", str(REPO / "src"), str(source)],
            capture_output=True, text=True)

    leaked = sorted({line.split()[-1] for line in listed.stderr.splitlines()
                     if "FEXCore/" in line or "/fex/" in line})
    if leaked:
        return {"status": "FAIL", "iterations": 1, "actual": leaked[:5],
                "reason": "the public API pulls in backend headers", "evidence": []}

    return {"status": "PASS", "iterations": 1,
            "actual": "compiles with -I src alone and opens no FEX header",
            "reason": None, "evidence": []}


def CheckDesktopConfigure(enabled: bool) -> dict:
    """B06: configure the desktop build to show the new targets did not break it.

    Opt-in via --check-desktop because a full desktop configure takes minutes and would make every
    routine run slow. Skipping it reports NOT_RUN, never a remembered PASS.
    """
    if not enabled:
        return NotRun("desktop configure not requested; pass --check-desktop to run it")
    cmake = shutil.which("cmake")
    if cmake is None:
        return NotRun("cmake not available")
    with tempfile.TemporaryDirectory() as tmp:
        result = subprocess.run(
            [cmake, "-S", str(REPO), "-B", tmp, "-DCMAKE_BUILD_TYPE=Release"],
            capture_output=True, text=True, timeout=900)
    if result.returncode != 0:
        tail = [line for line in result.stderr.strip().splitlines() if line][-5:]
        return {"status": "FAIL", "iterations": 1, "actual": tail,
                "reason": "desktop configure failed", "evidence": []}
    return {"status": "NOT_RUN", "auxiliary_status": "PASS", "iterations": 1,
            "actual": "desktop CMake configure succeeded",
            "reason": None,
            "scope_note": "configure only; a full desktop link was not run",
            "evidence": []}


def run_device_suite(binary: Path, serial: str | None) -> SuiteRun:
    """Push one cross-compiled suite to a device, run it, and clean up.

    Separate from run_suite because these binaries are arm64/bionic and cannot execute on the build
    host. An unavailable adb or device yields an error rather than an empty pass set, so cases stay
    NOT_RUN with a stated reason instead of being silently unpromoted.
    """
    if not binary.is_file():
        return SuiteRun(error=f"missing: {binary}", never_started=True)
    if not shutil.which("adb"):
        return SuiteRun(error="adb not found; device suite skipped", never_started=True)

    adb = ["adb"] + (["-s", serial] if serial else [])
    remote = f"/data/local/tmp/shadps4-v0-{os.getpid()}-{time.monotonic_ns()}-{binary.name}"
    local_sha = sha256_of(binary)
    deployment = ""
    try:
        push = subprocess.run(adb + ["push", str(binary), remote], capture_output=True, text=True,
                              timeout=300)
        if push.returncode != 0:
            # Never reached the device, so nothing was attempted there.
            return SuiteRun(error=f"adb push failed: {push.stderr.strip()}", never_started=True)
        chmod = subprocess.run(adb + ["shell", "chmod", "755", remote], capture_output=True, text=True,
                               timeout=60)
        hashed = subprocess.run(adb + ["shell", "sha256sum", remote], capture_output=True, text=True,
                                timeout=60)
        device_sha = hashed.stdout.split()[0] if hashed.stdout.split() else None
        deployment = "DEPLOY " + json.dumps({"remote": remote, "local_sha256": local_sha,
                                              "device_sha256": device_sha}) + "\n"
        if chmod.returncode or hashed.returncode or local_sha != device_sha:
            return SuiteRun(output=deployment + chmod.stderr + hashed.stderr,
                            error="deployed binary permission or SHA-256 verification failed")
        started = time.monotonic()
        # Echo the guest exit status explicitly. `adb shell` does not reliably propagate it on every
        # Android version, and taking adb's own status instead would report success for a suite that
        # aborted on the device.
        result = subprocess.run(adb + ["shell", f"{remote}; echo __EXIT__=$?"],
                                capture_output=True, text=True, timeout=600)
        elapsed = time.monotonic() - started
    except subprocess.TimeoutExpired as exc:
        def decoded(value):
            return value.decode(errors="replace") if isinstance(value, bytes) else (value or "")
        return SuiteRun(output=deployment + decoded(exc.stdout) + decoded(exc.stderr), timed_out=True)
    except OSError as exc:
        return SuiteRun(error=f"device suite error: {exc}")
    finally:
        # Do not leave the binary on the device even when the run failed.
        if shutil.which("adb"):
            subprocess.run(adb + ["shell", "rm", "-f", remote], capture_output=True, text=True,
                           timeout=60)

    device_exit: int | None = None
    for line in result.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("__EXIT__="):
            try:
                device_exit = int(stripped.split("=", 1)[1])
            except ValueError:
                device_exit = None
            break
    # Same parser as the host path, so duplicate IDs and iteration identity behave identically
    # wherever a suite runs.
    parsed, counts, conflicts = parse_sub_cases(result.stdout)

    if device_exit is None:
        return SuiteRun(cases=parsed, output=deployment + result.stdout + result.stderr,
                        error="the device did not report an exit status",
                        iteration_counts=counts, conflicts=conflicts)

    output = (deployment + result.stdout + result.stderr +
              f"\n(device exit {device_exit}, adb exit {result.returncode}, {elapsed:.2f}s)")
    return SuiteRun(cases=parsed, output=output, exit_code=device_exit,
                    iteration_counts=counts, conflicts=conflicts)


def pick_binary(build_dir: Path, names: list[str]) -> Path:
    """First existing candidate, else the first name so the error says what was expected."""
    for name in names:
        candidate = build_dir / name
        if candidate.is_file():
            return candidate
    return build_dir / names[0]


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def git(*args: str, cwd: Path | None = None) -> str:
    """Run git in the repo, or in `cwd` for a submodule."""
    try:
        return subprocess.run(["git", "-C", str(cwd or REPO), *args], capture_output=True,
                              text=True, timeout=30).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def probe_device(serial: str | None) -> dict:
    device = {
        "attached": False,
        "api": None, "abi": None,
        "kernel_page_size": None, "process_page_size": None,
        "physical_device": None, "soc": None, "kernel": None,
        "page_size_compat_enabled": None,
        "note": "no device attached; in-app page size unverified",
    }
    try:
        listing = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=15)
    except (subprocess.SubprocessError, OSError, FileNotFoundError):
        device["note"] = "adb unavailable"
        return device
    serials = [ln.split()[0] for ln in listing.stdout.splitlines()[1:]
               if ln.strip().endswith("device")]
    if not serials:
        return device
    target = serial or serials[0]

    def prop(name: str) -> str:
        out = subprocess.run(["adb", "-s", target, "shell", "getprop", name],
                             capture_output=True, text=True, timeout=15)
        return out.stdout.strip()

    page = subprocess.run(["adb", "-s", target, "shell", "getconf", "PAGE_SIZE"],
                          capture_output=True, text=True, timeout=15).stdout.strip()
    device.update({
        "attached": True, "serial": target,
        "api": int(prop("ro.build.version.sdk") or 0) or None,
        "abi": prop("ro.product.cpu.abi") or None,
        "kernel_page_size": int(page) if page.isdigit() else None,
        "soc": prop("ro.soc.model") or prop("ro.board.platform") or None,
        "kernel": subprocess.run(["adb", "-s", target, "shell", "uname", "-r"],
                                 capture_output=True, text=True, timeout=15).stdout.strip() or None,
        # Kernel page size is necessary but not sufficient. The acceptance
        # matrix wants the in-app sysconf value, which needs the APK.
        "note": ("kernel page size read from the device; the in-app sysconf value "
                 "requires the validation APK and is still unverified"),
    })
    return device


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--build-dir", default="/tmp/v0build")
    parser.add_argument("--fex-build-dir", default=None,
                        help="Android FEXCore build directory from scripts/android/build-fexcore-android. "
                             "When given, the bionic smoke probe is run on a device (P04/P05).")
    parser.add_argument("--apk", default=None,
                        help="APK whose native libraries decide B02. Without it, B02 records "
                             "auxiliary coverage from standalone ELFs and stays NOT_RUN.")
    parser.add_argument("--check-desktop", action="store_true",
                        help="run the desktop CMake configure for B06; slow, so off by default")
    parser.add_argument("--serial", default=None)
    parser.add_argument("--expected-page-size", type=int, default=None)
    parser.add_argument("--out", default=str(REPO / "docs/validation/v0/results.json"))
    parser.add_argument("--run-id", default=None)
    args = parser.parse_args()

    build_dir = Path(args.build_dir)
    run_id = args.run_id or datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

    print(f"run id: {run_id}")
    print(f"build dir: {build_dir}\n")

    # Accept either the CMake target names or the ad-hoc names, so pointing at
    # a real build directory does not silently under-report as NOT_RUN.
    suites = {
        "api_contract_tests": pick_binary(build_dir, ["guest_cpu_contract_tests",
                                                      "api_contract_tests"]),
        "hle_abi_tests": pick_binary(build_dir, ["guest_cpu_hle_abi_tests",
                                                 "hle_abi_tests"]),
        "host_page_size_probe": pick_binary(build_dir, ["host_page_size_probe"]),
    }
    observed: dict[str, tuple[str, str]] = {}
    suite_meta = {}
    # Sub-cases from a suite whose process did not exit cleanly. Recorded so the affected
    # acceptance cases can be marked FAIL rather than silently left NOT_RUN, which would read as
    # "not attempted" when the truth is "attempted and the process failed".
    tainted: dict[str, str] = {}
    # Which sub-cases were produced by a run on a device, so a case can say where its evidence
    # actually came from rather than always claiming HOST.
    device_subs: set[str] = set()

    log_dir = Path(args.out).resolve().parent / (Path(args.out).stem + "-suites")
    log_dir.mkdir(parents=True, exist_ok=True)

    def record_suite(name: str, binary: Path, run: SuiteRun, on_device: bool) -> None:
        log_path = log_dir / (name + ".txt")
        log_path.write_text(run.output + "\n" + json.dumps({
            "exit_code": run.exit_code, "timed_out": run.timed_out,
            "never_started": run.never_started, "error": run.error}) + "\n")
        failures = sum(1 for status, _ in run.cases.values() if status == "FAIL")
        meta = {
            "output_log": os.path.relpath(log_path, REPO),
            "output_sha256": sha256_of(log_path),
            "binary": str(binary),
            "sha256": sha256_of(binary) if binary.is_file() else None,
            "sub_cases": len(run.cases),
            "failures": failures,
            "exit_code": run.exit_code,
            "timed_out": run.timed_out,
            "error": run.error,
            "usable": run.usable,
            # A sub-case that reported different verdicts across repeats. Recorded because the
            # parser resolves it to the worst verdict, and that resolution should be visible
            # rather than silent.
            "verdict_conflicts": run.conflicts,
            "repeated_sub_cases": {k: v for k, v in run.iteration_counts.items() if v > 1},
        }
        if on_device:
            meta["ran_on_device"] = bool(run.cases) and run.usable
        suite_meta[name] = meta

        print(f"{name}: {len(run.cases)} sub-case(s), {failures} failure(s)"
              + ("" if run.usable else f"  [UNUSABLE: {run.failure_reason()}]"))

        if run.usable:
            # Merge rather than overwrite. The same suite can run on the host and on a device, and
            # each may skip cases the other exercises: M13f is a SKIP on a W^X host and a real PASS
            # on Swan. Blind update() would let whichever ran last win, so a device SKIP could erase
            # a host PASS.
            #
            # FAIL always wins: a case that failed anywhere failed. Otherwise a real verdict
            # replaces a SKIP, and a SKIP never replaces a real verdict.
            for sub, result in run.cases.items():
                previous = observed.get(sub)
                if previous is None:
                    observed[sub] = result
                    continue
                if previous[0] == "FAIL" or result[0] == "FAIL":
                    observed[sub] = previous if previous[0] == "FAIL" else result
                elif previous[0] == "SKIP" and result[0] != "SKIP":
                    observed[sub] = result
            if on_device:
                device_subs.update(run.cases)
            if not run.cases:
                print(f"  WARNING: no results parsed from {binary}")
        elif run.never_started:
            # The process was never launched -- no binary, no adb, push failed. Nothing was
            # attempted, so the owned cases stay NOT_RUN. Marking them FAIL would invent failures
            # for suites that were simply not built for this invocation.
            print(f"  (not attempted: {run.failure_reason()})")
        else:
            # Its printed results cannot be trusted: a suite can print PASS for everything and
            # still crash or exit non-zero afterwards.
            #
            # Taint what the suite *owns*, not what it printed. A suite that died before its first
            # result line has an empty run.cases, so taint derived from output covered nothing and
            # the affected cases stayed NOT_RUN -- indistinguishable from never having been run.
            reason = run.failure_reason() or "suite did not complete"
            for sub in set(run.cases) | sub_cases_owned_by(name):
                tainted[sub] = reason
            print(f"  {run.output.splitlines()[-1] if run.output else 'no output'}")

    for name, binary in suites.items():
        record_suite(name, binary, run_suite(binary), on_device=False)

    # The bionic FEXCore probes are arm64 and must run on a device, so they are opt-in via
    # --fex-build-dir. Without it the cases they feed stay NOT_RUN with their stated reason.
    #
    # guest_execution_tests is included even though it currently fails: the 2026-09-08 review (R6)
    # found that leaving it out let already-known execution failures sit in NOT_RUN while the report
    # described the backend as absent. A case that ran and failed must read FAIL.
    #
    # The contract suite runs on the device too when it was cross-compiled. Some of its cases can
    # only be exercised there -- M13f needs a host that permits RWX, which macOS refuses and Swan
    # allows -- so the host run reports SKIP and this run supplies the real result. Device results
    # are applied after the host ones, so a genuine device PASS completes a case the host could not,
    # rather than the rule being relaxed to accept a skip (2026-09-08 poison review, R5).
    if args.fex_build_dir:
        for suite_name in ("fexcore_bionic_smoke", "guest_execution_tests",
                           "guest_cpu_contract_tests"):
            fex_binary = pick_binary(Path(args.fex_build_dir), [suite_name])
            if suite_name == "guest_cpu_contract_tests" and not fex_binary.is_file():
                # Optional: the contract suite is only in the FEX build dir when it was
                # cross-compiled there. Its absence is not a device failure.
                continue
            record_suite(suite_name, fex_binary,
                         run_device_suite(fex_binary, args.serial), on_device=True)

    host_page = os.sysconf("SC_PAGESIZE")
    cases = []
    for case_id, (description, blocked_reason) in CASES.items():
        entry = {
            "id": case_id,
            "description": description,
            "status": "NOT_RUN",
            "environment": "HOST",  # replaced below once its sub-cases are known
            "iterations": 0,
            "expected": None,
            "actual": None,
            "reason": blocked_reason,
            "evidence": [],
        }
        sub_ids = SUITE_MAP.get(case_id)
        if sub_ids and blocked_reason is None:
            found = {s: observed[s] for s in sub_ids if s in observed}
            failed = [s for s, (status, _) in found.items() if status == "FAIL"]
            # A SKIP is a sub-case that did not run. It must not complete a case: a suite that
            # cannot exercise something on this host printed an explanatory line and still counted
            # as coverage before this (R5). Treated as absent, with the reason preserved.
            skipped = [s for s, (status, _) in found.items() if status == "SKIP"]
            # Sub-cases whose suite did not exit cleanly. Their printed verdict is unusable, but
            # the attempt happened, so this is a failure and not an absence.
            spoiled = [s for s in sub_ids if s in tainted]
            missing = [s for s in sub_ids
                       if s not in observed and s not in tainted] + skipped

            # Failure outranks absence. A case with one FAIL and one missing sub-case previously
            # took the "missing" branch and reported NOT_RUN, hiding the failure entirely.
            if failed or spoiled:
                entry["status"] = "FAIL"
                entry["iterations"] = 1
                entry["actual"] = {s: found[s][0] for s in sub_ids if s in found}
                reasons = []
                if failed:
                    reasons.append("failed sub-cases: " + ", ".join(failed))
                if spoiled:
                    reasons.append("unusable suite for: " + ", ".join(
                        f"{s} ({tainted[s]})" for s in spoiled))
                if missing:
                    reasons.append("did not report: " + ", ".join(missing))
                entry["reason"] = "; ".join(reasons)
            elif missing:
                parts = []
                absent = [s for s in missing if s not in skipped]
                if absent:
                    parts.append("sub-cases did not report: " + ", ".join(absent))
                if skipped:
                    parts.append("skipped here: " + ", ".join(
                        f"{s} ({found[s][1]})" if found.get(s) and found[s][1] else s
                        for s in skipped))
                entry["reason"] = "; ".join(parts)
                entry["actual"] = {s: found[s][0] for s in sub_ids if s in found}
            else:
                entry["status"] = "PASS"
                entry["iterations"] = 1
                entry["actual"] = {s: found[s][0] for s in sub_ids}
                entry["reason"] = None

            # Say where the evidence came from. Some sub-cases can only be decided on a device --
            # M13f needs a host that permits RWX -- so a case can be settled by a mix of both.
            on_dev = [s for s in sub_ids if s in device_subs]
            if on_dev:
                entry["environment"] = "DEVICE" if len(on_dev) == len(
                    [s for s in sub_ids if s in observed]) else "HOST+DEVICE"

            if entry["status"] not in ("NOT_RUN",):
                # Say where the evidence came from. Device sub-cases are prefixed F/G by
                # convention, and calling those "host-only" is what made the last report claim
                # device results were host results.
                on_device = any(s.startswith(("F", "G")) for s in sub_ids)
                entry["scope_note"] = (
                    f"evidence environment: {entry['environment']}; "
                    "consult the per-suite artifact and output records")
                entry["evidence"] = [meta["output_log"] for name, meta in suite_meta.items()
                                     if any(sub in sub_cases_owned_by(name) for sub in sub_ids)]
        if entry["status"] == "PASS" and case_id in INCOMPLETE_COVERAGE:
            entry["auxiliary_status"] = "PASS"
            entry["status"] = "NOT_RUN"
            entry["reason"] = "full acceptance pending: " + INCOMPLETE_COVERAGE[case_id]
        # Scope is independent of whether a suite happened to execute or pass.
        if case_id in DEFERRED_BY_SCOPE:
            entry["observed_status"] = entry["status"]
            entry["status"] = "DEFERRED_BY_SCOPE"
            entry["reason"] = DEFERRED_BY_SCOPE[case_id]
        cases.append(entry)

    # B02/B05/B06 are decided by running a check now, not by a hardcoded verdict.
    #
    # The 2026-09-08 review (R6) pointed an empty build directory at this runner and still got three
    # PASSes, because these were unconditionally overwritten with a stored answer. A PASS has to
    # mean "this ran, against these artifacts, in this invocation".
    for case in cases:
        if case["id"] == "B02":
            case.update(CheckNativeElf(build_dir, args.fex_build_dir, args.apk))
        elif case["id"] == "B05":
            case.update(CheckPublicApiOnlyConsumer())
        elif case["id"] == "B06":
            case.update(CheckDesktopConfigure(args.check_desktop))

    passed = sum(1 for c in cases if c["status"] == "PASS")
    failed = sum(1 for c in cases if c["status"] == "FAIL")
    not_run = sum(1 for c in cases if c["status"] == "NOT_RUN")
    deferred = sum(1 for c in cases if c["status"] == "DEFERRED_BY_SCOPE")
    # Deferred cases are out of the current denominator: counting them would make the remaining
    # work look larger, and counting them as passes would claim scope that is not being validated.
    in_scope = len(cases) - deferred

    # Status selection is mechanical, so it cannot be talked upwards.
    if failed:
        release_status = "V0_IN_PROGRESS"
    elif any(c["reason"] and "[NO-BACKEND]" in c["reason"] for c in cases):
        # Unimplemented capability is work remaining, not a blocker.
        #
        # This previously reported V0_BLOCKED, which the spec reserves for an external dependency,
        # capability or rule that cannot be resolved by continuing to implement -- the original FEX
        # contribution-rule blocker was one. What is missing now (interrupts, bounded Step, real HLE
        # gates, the app) is ordinary implementation work, and calling that "blocked" overstates the
        # obstacle in the opposite direction from calling it "pending".
        release_status = "V0_IN_PROGRESS"
    elif not_run:
        release_status = "V0_IN_PROGRESS"
    else:
        release_status = "V0_ACCEPTED"

    report = {
        "schema_version": 1,
        "spec": "android-fex-v0",
        "run_id": run_id,
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "baseline_commit": "a712889343ccd2588b712988dae0a76a104e0dce",
        "implementation_commit": git("rev-parse", "HEAD"),
        "implementation_branch": git("rev-parse", "--abbrev-ref", "HEAD"),
        "working_tree_dirty": bool(git("status", "--porcelain")),
        # Read from the checkout rather than hardcoded: the previous constants named an FEX commit
        # that has not been the one in use for several rounds, so the report described a build that
        # was never run.
        "fex_base_commit": git("rev-parse", "HEAD", cwd=REPO / "references/FEX"),
        "fex_downstream_revision_or_patch_hash": git("rev-parse", "--abbrev-ref", "HEAD",
                                                     cwd=REPO / "references/FEX"),
        "toolchain_lock_sha256": sha256_of(REPO / "docs/validation/v0/environment.lock.json"),
        "apk_sha256": None,
        "native_build_ids": {},
        "build_host": {
            "page_size": host_page,
            "arch": os.uname().machine,
            "system": os.uname().sysname,
        },
        "device": probe_device(args.serial),
        "expected_page_size": args.expected_page_size,
        "capabilities": {
            "memory_mode": "DirectMapped",
            "smc_mode": "ExplicitPublication",
            "guest_features": [],
            "step_scope": [],
            # Reflects what this invocation actually exercised, not a fixed string.
            "backend": ("FEXCore via src/core/guest_cpu/fex (device suites ran)"
                        if args.fex_build_dir else
                        "not exercised in this invocation; no --fex-build-dir given"),
        },
        "suites": suite_meta,
        "summary": {"passed": passed, "failed": failed, "not_run": not_run,
                    "deferred_by_scope": deferred, "in_scope_total": in_scope,
                    "total": len(cases)},
        "cases": cases,
        "round2": round2_report(observed, tainted),
        "release_status": release_status,
        "release_status_reason": (
            f"This invocation observed {passed} complete acceptance passes, {failed} failures, "
            f"{not_run} incomplete/unrun cases and {deferred} scope deferrals. "
            "Auxiliary unit evidence is not complete acceptance. "
            "Running-thread interruption, real HLE/callback and app integration remain incomplete."),
    }

    out_path = Path(args.out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(report, indent=2) + "\n")

    print(f"\n{passed} PASS, {failed} FAIL, {not_run} NOT_RUN of {in_scope} in-scope cases"
          + (f" ({deferred} deferred by scope)" if deferred else ""))
    print(f"release status: {release_status}")
    print(f"wrote {out_path}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
