def round2_report(observed, tainted):
    result = []
    for case_id, required in ROUND2_MAP.items():
        failed = [sub for sub in required if sub in tainted or observed.get(sub, (None,))[0] == "FAIL"]
        missing = [sub for sub in required if observed.get(sub, (None,))[0] != "PASS"]
        result.append({"id": case_id, "status": "FAIL" if failed else "NOT_RUN",
                       "auxiliary_status": "FAIL" if failed else ("PASS" if required and not missing else "NOT_RUN"),
                       "auxiliary_scope": "listed CLI subchecks only",
                       "required_subchecks": required, "missing": missing, "failed": failed,
                       "remaining": ROUND2_PENDING.get(case_id, "target environment / full normative acceptance pending")})
    return {"spec": "docs/specs/android-fex-round2.md", "total": len(result), "cases": result}

