#!/usr/bin/env python3
"""Build the live Mesa submodule and bind its exact ELF to the native host/APK.

`prebuilt --lock` instead binds a checksum-pinned release archive (an opt-in for hosts that
cannot build Mesa); bind-host/package then check that pin rather than the Mesa source.
"""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import platform
import shutil
import struct
import subprocess
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parents[2]
LOCK = ROOT / "runtime/locks/turnip-bionic-mainline.json"


def driver_dependencies(library):
    """Check the actual ELF, including on Windows packaging hosts without readelf.

    Vulkan is a C ABI boundary. The ICD must carry its own hidden C++ runtime;
    the app's shared runtime is not guaranteed visible in the driver namespace.
    Read PT_DYNAMIC rather than strings/section names (release ELFs may be stripped).
    """
    def region(offset, size):
        if offset < 0 or size < 0 or offset + size > len(library):
            raise ValueError("Turnip ELF has an out-of-file range")
        return library[offset:offset + size]

    header = region(0, 64)
    if header[:7] != b"\x7fELF\x02\x01\x01" or struct.unpack_from("<HH", header, 16) != (3, 183):
        raise ValueError("Turnip must be an ELF64 little-endian AArch64 shared library")
    phoff = struct.unpack_from("<Q", header, 32)[0]
    phsize, phcount = struct.unpack_from("<HH", header, 54)
    if phsize != 56 or not phcount or phcount == 0xffff:
        raise ValueError("Turnip ELF has an invalid program-header table")
    headers = [struct.unpack("<IIQQQQQQ", region(phoff + i * phsize, phsize))
               for i in range(phcount)]
    dynamic = [p for p in headers if p[0] == 2]
    if len(dynamic) != 1 or dynamic[0][5] % 16:
        raise ValueError("Turnip ELF needs one complete PT_DYNAMIC table")
    table = region(dynamic[0][2], dynamic[0][5])
    tags = {}
    for tag, value in struct.iter_unpack("<qQ", table):
        if tag == 0:
            break
        tags.setdefault(tag, []).append(value)
    else:
        raise ValueError("Turnip ELF has an unterminated dynamic table")
    if len(tags.get(5, [])) != 1 or len(tags.get(10, [])) != 1:
        raise ValueError("Turnip ELF has no unique dynamic string table")
    address, size = tags[5][0], tags[10][0]
    loads = [p for p in headers if p[0] == 1 and p[3] <= address and
             address + size <= p[3] + p[5]]
    if len(loads) != 1 or not size:
        raise ValueError("Turnip ELF dynamic strings are not file-backed")
    strings = region(loads[0][2] + address - loads[0][3], size)
    needed = []
    for offset in tags.get(1, []):
        end = strings.find(b"\0", offset)
        if offset >= size or end <= offset:
            raise ValueError("Turnip ELF has an invalid DT_NEEDED string")
        needed.append(strings[offset:end].decode("ascii"))
    # Inspect bytes, not identity.json: old same-source prebuilts used the NDK
    # default shared STL and must be rebuilt even when Mesa itself is unchanged.
    runtimes = {"libc++_shared.so", "libc++.so", "libc++abi.so", "libunwind.so",
                "libgnustl_shared.so", "libstdc++.so", "libstdc++.so.6", "libgcc_s.so.1"}
    rejected = sorted(set(needed) & runtimes)
    if rejected:
        raise ValueError("Turnip depends on a dynamic C++ runtime: " + ", ".join(rejected) +
                         "; rebuild with the static, hidden C++ runtime recipe")
    return sorted(set(needed))


def sha(data):
    return hashlib.sha256(data).hexdigest()


def digest(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def write(path, data):
    path = Path(path)
    if path.is_file() and path.read_bytes() == data:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        stream.write(data)
        temp = Path(stream.name)
    temp.chmod(0o644)
    temp.replace(path)


def json_write(path, value):
    write(path, (json.dumps(value, indent=2, sort_keys=True) + "\n").encode())


def source_identity():
    lock = json.loads(LOCK.read_text())
    source = (ROOT / lock["source_path"]).resolve()
    source.relative_to(ROOT)
    def git(*args):
        return subprocess.check_output(["git", "-C", str(source), *args])
    subprocess.run(["git", "-C", str(source), "merge-base", "--is-ancestor",
                    lock["base_commit"], "HEAD"], check=True)
    patch = git("diff", "--binary", "HEAD")
    untracked = {}
    for raw in git("ls-files", "--others", "--exclude-standard", "-z").split(b"\0"):
        if raw:
            name = os.fsdecode(raw)
            path = source / name
            if path.is_file():
                untracked[name] = digest(path)
    state = {"source_commit": git("rev-parse", "HEAD").decode().strip(),
             "source_diff_sha256": sha(patch), "untracked_files": untracked,
             "source_dirty": bool(patch or untracked),
             "recipe_sha256": digest(__file__), "lock_sha256": digest(LOCK)}
    state["source_identity_sha256"] = sha(json.dumps(state, sort_keys=True).encode())
    return source, lock, state, patch


def prebuilt_identity(lock_path):
    lock = json.loads(Path(lock_path).read_text())
    state = {"prebuilt_lock": str(Path(lock_path).resolve()), "lock_sha256": digest(lock_path),
             "recipe_sha256": digest(__file__)}
    state["source_identity_sha256"] = sha(json.dumps(state, sort_keys=True).encode())
    return lock, state


def checked_output(directory):
    identity = json.loads((directory / "identity.json").read_text())
    if digest(directory / identity["library"]) != identity["library_sha256"]:
        raise ValueError("Built Turnip ELF does not match its identity")
    driver_dependencies((directory / identity["library"]).read_bytes())
    if identity.get("prebuilt"):
        expected = prebuilt_identity(identity["prebuilt_lock"])[1]["source_identity_sha256"]
        if expected != identity["source_identity_sha256"]:
            raise ValueError("Turnip prebuilt lock changed: rebuild shadps4_host before packaging the APK")
    elif source_identity()[2]["source_identity_sha256"] != identity["source_identity_sha256"]:
        raise ValueError("Mesa source changed: rebuild shadps4_host before packaging the APK")
    return identity


def prebuilt(args):
    lock, state = prebuilt_identity(args.lock)
    cache = ROOT / "build/drivers" / (lock["archive_sha256"] + ".zip")
    if not cache.is_file():
        raise ValueError(f"Prebuilt Turnip archive is not cached: {cache} (scripts/android/"
                         "prepare-bionic-turnip --lock downloads and verifies it)")
    archive = cache.read_bytes()
    if sha(archive) != lock["archive_sha256"]:
        raise ValueError("Turnip archive SHA256 mismatch")
    with zipfile.ZipFile(io.BytesIO(archive)) as source:
        if source.namelist().count(lock["library"]) != 1:
            raise ValueError("Missing or duplicate Turnip ELF")
        library = source.read(lock["library"])
    if sha(library) != lock["library_sha256"]:
        raise ValueError("Turnip ELF SHA256 mismatch")
    needed = driver_dependencies(library)
    identity = {**lock, **state, "prebuilt": True, "needed": needed,
                "cxx_runtime": "static-hidden"}
    write(args.out / lock["library"], library)
    write(args.out / "source.patch", b"")
    json_write(args.out / "identity.json", identity)
    header = ('#pragma once\nnamespace TurnipBuild {\n'
              f'inline constexpr char Sha256[] = "{identity["library_sha256"]}";\n'
              f'inline constexpr char Source[] = "{state["source_identity_sha256"]}";\n}}\n')
    write(args.out / "turnip_identity.h", header.encode())
    # The release archive carries only the ELF; Mesa's license texts come from the submodule.
    mesa = ROOT / json.loads(LOCK.read_text())["source_path"]
    write(args.out / "licenses/Mesa-license.rst", (mesa / "docs/license.rst").read_bytes())
    for path in (mesa / "licenses").rglob("*"):
        if path.is_file():
            write(args.out / "licenses/Mesa" / path.relative_to(mesa / "licenses"), path.read_bytes())
    print("TURNIP_PREBUILT_PASS", lock.get("release", ""), identity["library_sha256"])


def same_source_prebuilt(args, directory):
    """Reuse a Turnip ELF built elsewhere (Linux/macOS, the cloud host via
    build-turnip-remote) from the same Mesa source tree: hosts without Mesa's
    build tools (Windows) bind that exact ELF via SHADPS4_TURNIP_PREBUILT. The
    current tree must equal the prebuilt's source byte for byte."""
    source, lock, state, patch = source_identity()
    directory = Path(directory)
    original = json.loads((directory / "identity.json").read_text())
    library = (directory / original["library"]).read_bytes()
    if sha(library) != original["library_sha256"]:
        raise ValueError("Prebuilt Turnip ELF does not match its identity")
    needed = driver_dependencies(library)
    if state["source_dirty"] or original["untracked_files"]:
        raise ValueError("Prebuilt Turnip needs a clean Mesa tree and a prebuilt without untracked files")
    tree_diff = subprocess.check_output(["git", "-C", str(source), "diff", "--binary",
                                         original["source_commit"], "HEAD"])
    if sha(tree_diff) != original["source_diff_sha256"]:
        raise ValueError("Mesa HEAD differs from the prebuilt Turnip source; rebuild on Linux/macOS")
    identity = {**original, **state, "library_sha256": sha(library), "needed": needed,
                "cxx_runtime": "static-hidden",
                "prebuilt_source_identity_sha256": original["source_identity_sha256"]}
    identity.pop("libcxx_sha256", None)
    # Keep the producer's static-runtime notices when reusing its binary on
    # Windows or another host without the producer's NDK installation.
    if (directory / "licenses").resolve() != (args.out / "licenses").resolve():
        shutil.copytree(directory / "licenses", args.out / "licenses", dirs_exist_ok=True)
    write(args.out / lock["library"], library)
    write(args.out / "source.patch", patch)
    json_write(args.out / "identity.json", identity)
    header = ('#pragma once\nnamespace TurnipBuild {\n'
              f'inline constexpr char Sha256[] = "{identity["library_sha256"]}";\n'
              f'inline constexpr char Source[] = "{state["source_identity_sha256"]}";\n}}\n')
    write(args.out / "turnip_identity.h", header.encode())
    write(args.out / "licenses/Mesa-license.rst", (source / "docs/license.rst").read_bytes())
    for path in (source / "licenses").rglob("*"):
        if path.is_file():
            write(args.out / "licenses/Mesa" / path.relative_to(source / "licenses"), path.read_bytes())
    print("TURNIP_SOURCE_PREBUILT", identity["source_commit"], identity["library_sha256"])


def build(args):
    if os.environ.get("SHADPS4_TURNIP_PREBUILT"):
        same_source_prebuilt(args, os.environ["SHADPS4_TURNIP_PREBUILT"])
        return
    source, lock, state, patch = source_identity()
    ndk = args.ndk.resolve()
    if f"Pkg.Revision = {lock['ndk']}" not in (ndk / "source.properties").read_text():
        raise ValueError("Turnip NDK must match the source recipe: " + lock["ndk"])
    host = {"Darwin": "darwin-x86_64", "Linux": "linux-x86_64"}[platform.system()]
    toolchain = ndk / "toolchains/llvm/prebuilt" / host
    api = lock["api"]
    build_root = ROOT / f"build/turnip-api{api}"
    build_root.mkdir(parents=True, exist_ok=True)
    import fcntl  # POSIX only; the prebuilt, bind and package modes also run on Windows
    with (build_root / "shadps4-source.lock").open("w") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        state_before = source_identity()[2]
        if state_before != state:
            raise ValueError("Mesa source changed while waiting for its build")
        cross = build_root / "android-aarch64.ini"
        lines = ["[binaries]"]
        for key, value in {"c": f"aarch64-linux-android{api}-clang",
                           "cpp": f"aarch64-linux-android{api}-clang++",
                           "ar": "llvm-ar", "strip": "llvm-strip"}.items():
            lines.append(f"{key} = '{toolchain / 'bin' / value}'")
        lines += ["pkg-config = 'false'", "[host_machine]", "system = 'android'",
                  "cpu_family = 'aarch64'", "cpu = 'armv8-a'", "endian = 'little'"]
        write(cross, ("\n".join(lines) + "\n").encode())
        local_meson = ROOT / "build/turnip-build-venv/bin/meson"
        meson = os.environ.get("SHADPS4_TURNIP_MESON") or (
            str(local_meson) if local_meson.is_file() else shutil.which("meson"))
        if not meson or not shutil.which("ninja"):
            raise ValueError("Install Meson, Ninja and Mesa's Python dependencies (Mako, PyYAML, packaging)")
        environment = os.environ.copy()
        # Mesa also executes #!/usr/bin/env python3 generators directly. Use the
        # selected Meson's environment so its Mako/PyYAML dependencies apply.
        environment["PATH"] = str(Path(meson).resolve().parent) + os.pathsep + environment["PATH"]
        if platform.system() == "Darwin":
            brew_bins = [Path(prefix) / "opt" / package / "bin"
                         for prefix in ("/opt/homebrew", "/usr/local")
                         for package in ("bison", "flex")]
            environment["PATH"] = os.pathsep.join(
                [str(path) for path in brew_bins if path.is_dir()] + [environment["PATH"]])
        bison = shutil.which("bison", path=environment["PATH"])
        if not bison or subprocess.run([bison, "--help"], capture_output=True).stdout.find(
                b"counterexamples") < 0:
            raise ValueError("Mesa requires modern Bison (on macOS: brew install bison flex)")
        native = build_root / "native"
        # android-strict hides extensions newer than the platform-sdk-version CTS allowlist;
        # the emulator bundles Turnip on API 33 devices and needs everything Turnip implements
        # (e.g. VK_KHR_fragment_shader_barycentric, VK_KHR_maintenance8).
        options = ["--buildtype=release", "-Dplatforms=android", "-Dandroid-stub=true",
                   "-Dandroid-strict=false",
                   "-Dandroid-libbacktrace=disabled", f"-Dplatform-sdk-version={api}",
                   "-Dvulkan-drivers=freedreno", "-Dfreedreno-kmds=kgsl", "-Dgallium-drivers=",
                   "-Degl=disabled", "-Dgles1=disabled", "-Dgles2=disabled", "-Dopengl=false",
                   "-Dllvm=disabled", "-Dbuild-tests=false", "-Dzstd=disabled",
                   # Pass this explicitly so an existing shared-STL Meson build
                   # changes too; cross-file defaults alone do not override it.
                   "-Dcpp_link_args=['-static-libstdc++', "
                   "'-Wl,--exclude-libs,libc++_static.a:libc++abi.a:libunwind.a']"]
        configuration = {"source": str(source), "ndk": str(ndk), "options": options,
                         "recipe": digest(__file__), "bison": bison,
                         "flex": shutil.which("flex", path=environment["PATH"]), "meson": meson}
        config_file = build_root / "shadps4-configuration.json"
        previous = json.loads(config_file.read_text()) if config_file.is_file() else None
        if previous != configuration or not (native / "build.ninja").is_file():
            command = [meson, "setup"]
            if (native / "meson-private/coredata.dat").is_file():
                command += ["--reconfigure", "--clearcache"]
            subprocess.run(command + [str(native), str(source), "--cross-file", str(cross)] + options,
                           check=True, env=environment)
            json_write(config_file, configuration)
        subprocess.run(["ninja", "-C", str(native), "-j", os.environ.get("TURNIP_BUILD_JOBS", "6"),
                        "src/freedreno/vulkan/libvulkan_freedreno.so"], check=True, env=environment)
        if source_identity()[2] != state:
            raise ValueError("Mesa source changed during compilation; rebuild required")
        library = (native / "src/freedreno/vulkan/libvulkan_freedreno.so").read_bytes()
        needed = driver_dependencies(library)
        identity = {**lock, **state, "library_sha256": sha(library),
                    "cxx_runtime": "static-hidden", "needed": needed,
                    "libcxx_static_sha256": digest(toolchain / "sysroot/usr/lib/aarch64-linux-android/libc++_static.a"),
                    "libcxxabi_sha256": digest(toolchain / "sysroot/usr/lib/aarch64-linux-android/libc++abi.a"),
                    "build_options": options}
        write(args.out / lock["library"], library)
        write(args.out / "source.patch", patch)
        json_write(args.out / "identity.json", identity)
        header = ('#pragma once\nnamespace TurnipBuild {\n'
                  f'inline constexpr char Sha256[] = "{identity["library_sha256"]}";\n'
                  f'inline constexpr char Source[] = "{state["source_identity_sha256"]}";\n}}\n')
        write(args.out / "turnip_identity.h", header.encode())
        write(args.out / "licenses/Mesa-license.rst", (source / "docs/license.rst").read_bytes())
        write(args.out / "licenses/NDK-toolchain-NOTICE", (ndk / "NOTICE.toolchain").read_bytes())
        for path in (source / "licenses").rglob("*"):
            if path.is_file():
                write(args.out / "licenses/Mesa" / path.relative_to(source / "licenses"), path.read_bytes())
        print("TURNIP_SOURCE_PASS", identity["source_commit"], identity["library_sha256"],
              "dirty=" + str(identity["source_dirty"]))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["build", "prebuilt", "bind-host", "package"])
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--ndk", type=Path)
    parser.add_argument("--built", type=Path)
    parser.add_argument("--host", type=Path)
    parser.add_argument("--lock", type=Path)
    args = parser.parse_args()
    if args.mode == "prebuilt":
        if not args.lock:
            parser.error("prebuilt requires --lock")
        prebuilt(args)
        return
    if args.mode == "build":
        if not args.ndk:
            parser.error("build requires --ndk")
        build(args)
        return
    if not args.built or not args.host:
        parser.error("bind-host/package require --built and --host")
    identity = checked_output(args.built)
    binding = {"host_sha256": digest(args.host), "library_sha256": identity["library_sha256"],
               "source_identity_sha256": identity["source_identity_sha256"]}
    if identity["library_sha256"].encode() not in args.host.read_bytes():
        raise ValueError("Native host does not contain this Turnip pin; rebuild shadps4_host")
    if args.mode == "bind-host":
        json_write(args.out / "host-binding.json", binding)
    else:
        if json.loads((args.built / "host-binding.json").read_text()) != binding:
            raise ValueError("Native host/Turnip binding is stale; rebuild shadps4_host")
        for name in [identity["library"], "identity.json", "source.patch", "host-binding.json"]:
            write(args.out / name, (args.built / name).read_bytes())
        shutil.copytree(args.built / "licenses", args.out / "licenses", dirs_exist_ok=True)
        print("TURNIP_PACKAGE_PASS", identity["library_sha256"])


if __name__ == "__main__":
    main()
