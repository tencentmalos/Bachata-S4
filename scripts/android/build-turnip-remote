#!/usr/bin/env python3
"""Build the pinned Mesa Turnip on the bug_reports Ubuntu cloud host.

Hosts without Mesa's build tools (Windows) run this, then build the native
host with SHADPS4_TURNIP_PREBUILT pointing at --out (build-turnip-source
checks the prebuilt's source against the local tree byte for byte).

  python scripts/android/build-turnip-remote --out build/turnip-remote

Requirements: `ssh workbench-hub` reaches the Ubuntu host with a key (see
bug_reports/skills/windows-remote-hosts); the local Mesa submodule is a clean
commit that the remote can fetch from the lock's source URL. On the host the
work lives in /data00/bug_reports_work/shadps4-turnip: a docker image
(Ubuntu 24.04 + bison/flex/Meson), the NDK of the lock, a Mesa clone and a
minimal tree carrying this repository's recipe and lock.
"""
import argparse
import hashlib
import json
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
LOCK = ROOT / "runtime/locks/turnip-bionic-mainline.json"
HOST = "workbench-hub"
WORK = "/data00/bug_reports_work/shadps4-turnip"
IMAGE = "shadps4-turnip-build:2"
BASE_IMAGE = "xrgame-build:ubuntu24.04.5"   # plain Ubuntu 24.04 already on the host
NDK_URL = {"29.0.14206865": "https://dl.google.com/android/repository/android-ndk-r29-linux.zip"}

DOCKERFILE = f"""FROM {BASE_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \\
    git python3 python3-pip python3-mako python3-yaml python3-packaging bison flex \\
    ninja-build pkg-config unzip ca-certificates glslang-tools gcc g++ && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages meson==1.4.1
"""


def ssh(command, check=True, capture=False):
    args = ["ssh", "-o", "BatchMode=yes", HOST, command]
    if capture:
        return subprocess.run(args, check=check, capture_output=True, text=True).stdout
    return subprocess.run(args, check=check).returncode


def git(*args):
    return subprocess.check_output(["git", "-C", str(mesa), *args], text=True).strip()


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("--out", type=Path, required=True)
parser.add_argument("--jobs", default="24")
args = parser.parse_args()

lock = json.loads(LOCK.read_text())
mesa = ROOT / lock["source_path"]
commit = git("rev-parse", "HEAD")
if git("status", "--porcelain"):
    sys.exit("Mesa submodule has local changes: commit and push them to the fork first")
ndk_url = NDK_URL.get(lock["ndk"]) or sys.exit("No download URL for NDK " + lock["ndk"])
ndk_dir = f"{WORK}/android-ndk-r{lock['ndk'].split('.')[0]}"
q = shlex.quote

print("== remote setup", commit)
ssh(f"mkdir -p {WORK}/tree/scripts/android {WORK}/tree/runtime/locks {WORK}/tree/references {WORK}/out")
for local, remote in ((ROOT / "scripts/android/build-turnip-source", "tree/scripts/android/build-turnip-source"),
                      (LOCK, "tree/runtime/locks/turnip-bionic-mainline.json")):
    data = local.read_bytes().replace(b"\r\n", b"\n")
    subprocess.run(["ssh", "-o", "BatchMode=yes", HOST, f"cat > {WORK}/{remote}"], input=data, check=True)
ssh(f"""set -e; cd {WORK}
printf %s {q(DOCKERFILE)} > Dockerfile
docker image inspect {IMAGE} >/dev/null 2>&1 || docker build -t {IMAGE} .
if [ ! -f {ndk_dir}/source.properties ]; then
  curl -fL --retry 3 -o ndk.zip {q(ndk_url)} && unzip -q ndk.zip && rm ndk.zip; fi
grep -q 'Pkg.Revision = {lock["ndk"]}' {ndk_dir}/source.properties
if [ ! -d tree/references/mesa-turnip/.git ]; then
  git clone --filter=blob:none {q(lock["source"])} tree/references/mesa-turnip; fi
cd tree/references/mesa-turnip
git cat-file -e {commit}^{{commit}} 2>/dev/null || git fetch origin '+refs/heads/*:refs/remotes/origin/*'
git -c advice.detachedHead=false checkout --force {commit}
git clean -fdq""")

print("== remote build")
ssh(f"""set -e; cd {WORK}
docker run --rm -u $(id -u):$(id -g) -e HOME=/tmp -e TURNIP_BUILD_JOBS={args.jobs} \
  -v {WORK}:{WORK} -w {WORK}/tree {IMAGE} \
  python3 scripts/android/build-turnip-source build --ndk {ndk_dir} --out {WORK}/out
tar -C {WORK}/out -czf {WORK}/turnip-out.tgz .""")

args.out.mkdir(parents=True, exist_ok=True)
archive = args.out / "turnip-out.tgz"
subprocess.run(["scp", "-o", "BatchMode=yes", f"{HOST}:{WORK}/turnip-out.tgz", str(archive)], check=True)
subprocess.run(["tar", "-xzf", archive.name], cwd=args.out, check=True)
archive.unlink()
identity = json.loads((args.out / "identity.json").read_text())
if sha(args.out / identity["library"]) != identity["library_sha256"]:
    sys.exit("Downloaded Turnip does not match its identity")
if identity["source_commit"] != commit:
    sys.exit("Remote built a different commit")
print("TURNIP_REMOTE_PASS", commit, identity["library_sha256"])
