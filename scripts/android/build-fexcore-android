#
# Build FEXCore for Android (NDK/bionic) and link the on-device smoke probe.
#
# This is the first configuration in which FEXCore has been built against the NDK sysroot rather
# than a glibc cross toolchain. See docs/fex-android-bionic-build.md for what each requirement is
# for; the short version:
#
#   - NDK r29 or newer is mandatory: FEXCore uses std::atomic_ref, which the libc++ shipped with
#     r28c and earlier does not provide at all (not even under -fexperimental-library).
#   - BUILD_FEXCORE_ONLY skips Source/Tools, which is the Linux frontend an embedder replaces.
#
# Usage: scripts/android/build-fexcore-android [build-dir]

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
FEX="${REPO}/references/FEX"
BUILD="${1:-${REPO}/build/fexcore-android}"

SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-${HOME}/Library/Android/sdk}}"
API="${ANDROID_API:-35}"

die() {
  echo "error: $*" >&2
  exit 1
}

# --- toolchain selection -----------------------------------------------------
# Pick the newest installed NDK that actually has atomic_ref, rather than trusting a directory name.
# A package label is not proof of contents: this repository has two r28c installs whose reported
# Pkg.Revision disagrees with their directory.
NDK="${ANDROID_NDK:-}"
if [[ -z "${NDK}" ]]; then
  for candidate in $(ls -d "${SDK_ROOT}"/ndk/*/ 2>/dev/null | sort -Vr); do
    # Glob the prebuilt host dir explicitly; [[ -f ]] does not expand wildcards.
    if compgen -G "${candidate}toolchains/llvm/prebuilt/*/sysroot/usr/include/c++/v1/__atomic/atomic_ref.h" >/dev/null; then
      NDK="${candidate%/}"
      break
    fi
  done
fi
[[ -n "${NDK}" ]] || die "no NDK with std::atomic_ref found under ${SDK_ROOT}/ndk. FEXCore needs r29+."

PREBUILT="$(ls -d "${NDK}/toolchains/llvm/prebuilt"/*/ 2>/dev/null | head -1)"
[[ -n "${PREBUILT}" ]] || die "no prebuilt toolchain in ${NDK}"
PREBUILT="${PREBUILT%/}"

# Verify the capability instead of inferring it from the version string.
if [[ ! -f "${PREBUILT}/sysroot/usr/include/c++/v1/__atomic/atomic_ref.h" ]]; then
  die "${NDK} has no atomic_ref.h; FEXCore will not compile. Use NDK r29 or newer."
fi

CXX="${PREBUILT}/bin/aarch64-linux-android${API}-clang++"
[[ -x "${CXX}" ]] || die "missing compiler ${CXX}"

echo "NDK:   ${NDK}"
echo "API:   ${API}"
echo "build: ${BUILD}"
echo

# --- configure and build FEXCore --------------------------------------------
cmake -S "${FEX}" -B "${BUILD}" -G Ninja \
  -DCMAKE_TOOLCHAIN_FILE="${NDK}/build/cmake/android.toolchain.cmake" \
  -DANDROID_ABI=arm64-v8a \
  -DANDROID_PLATFORM="android-${API}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_FEXCORE_ONLY=ON \
  -DBUILD_TESTING=OFF \
  -DBUILD_THUNKS=OFF \
  -DBUILD_FEXCONFIG=OFF \
  -DENABLE_LTO=OFF \
  -DENABLE_CCACHE=OFF \
  -DENABLE_OFFLINE_TELEMETRY=OFF

cmake --build "${BUILD}"

# --- generate the guest fixtures ---------------------------------------------
# Assembled from source and disassembled back, so a wrong instruction is a build failure rather
# than a misleading test result. See the 2026-09-08 review, finding R2.
GENERATED="${BUILD}/generated-fixtures"
mkdir -p "${GENERATED}"
"${REPO}/scripts/android/generate-guest-fixtures" --output "${GENERATED}/guest_fixtures.h"
echo

# --- build the embedder through the canonical CMake targets --------------------
V0_BUILD="${BUILD}/v0"
cmake -S "${REPO}/cmake/fex" -B "${V0_BUILD}" -G Ninja \
  -DCMAKE_TOOLCHAIN_FILE="${NDK}/build/cmake/android.toolchain.cmake" \
  -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM="android-${API}" \
  -DANDROID_STL=c++_static -DCMAKE_BUILD_TYPE=RelWithDebInfo \
  -DV0_ENABLE_FEX=ON -DV0_BUILD_TESTS=ON \
  -DFEX_BUILD_DIR="${BUILD}" -DV0_FIXTURE_DIR="${GENERATED}"
cmake --build "${V0_BUILD}"

# Retain the existing runner entry paths; these are copies of the CMake outputs,
# never a second compilation/link recipe.
for probe in guest_execution_tests guest_cpu_contract_tests guest_cpu_hle_abi_tests fexcore_bionic_smoke; do
  cmake -E copy_if_different "${V0_BUILD}/${probe}" "${BUILD}/${probe}"
done
echo "built V0 targets in ${V0_BUILD}"
