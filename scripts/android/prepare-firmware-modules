#!/usr/bin/env python3
"""Copy the pinned PS4 firmware LLE modules from the private submodule into APK assets.

Reads runtime/locks/ps4-firmware-modules.json, checks every file's SHA-256 in
externals/ps4-firmware, and writes <out>/<file> plus <out>/index.json. Missing
submodule or a hash mismatch is an error; --skip produces an empty asset set
(the APK then has no firmware modules).
"""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import sys

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--lock", type=Path, default=ROOT / "runtime/locks/ps4-firmware-modules.json")
    parser.add_argument("--skip", action="store_true")
    args = parser.parse_args()
    lock = json.loads(args.lock.read_text(encoding="utf-8"))
    source = ROOT / lock["submodule"] / lock["directory"]
    if args.out.exists():
        shutil.rmtree(args.out)
    args.out.mkdir(parents=True)
    if not source.is_dir() and not args.skip:
        sys.exit(f"{source} is missing: run `git submodule update --init {lock['submodule']}` "
                 "(private repository) or build with -Pshadps4.bundleFirmware=false")
    if args.skip:
        (args.out / "index.json").write_text(json.dumps({"firmware": lock["firmware"], "modules": []}) + "\n")
        print("FIRMWARE_ASSETS_SKIPPED " + str(source))
        return
    names = [m["file"] for m in lock["modules"]]
    if len(set(names)) != len(names) or any(Path(n).name != n for n in names):
        sys.exit("invalid module list in " + str(args.lock))
    for module in lock["modules"]:
        data = (source / module["file"]).read_bytes()
        if hashlib.sha256(data).hexdigest() != module["sha256"]:
            sys.exit(f"SHA-256 mismatch: {module['file']}")
        if data[:4] != b"\x7fELF":
            sys.exit(f"not a decrypted ELF: {module['file']}")
        (args.out / module["file"]).write_bytes(data)
    index = {"firmware": lock["firmware"],
             "modules": [{"file": m["file"], "sha256": m["sha256"]} for m in lock["modules"]]}
    (args.out / "index.json").write_text(json.dumps(index, indent=1) + "\n", encoding="utf-8")
    print(f"FIRMWARE_ASSETS_PASS {lock['firmware']} {len(names)} modules")


if __name__ == "__main__":
    main()
