#!/usr/bin/env python3
"""Generate synthetic MP3 for guest_ajm_tests (no game or firmware data)."""
import argparse
import pathlib
import subprocess
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--ffmpeg', default='ffmpeg')
p.add_argument('--out', required=True, type=pathlib.Path)
a = p.parse_args()
a.out.parent.mkdir(parents=True, exist_ok=True)
subprocess.run([a.ffmpeg, '-hide_banner', '-loglevel', 'error', '-y', '-f', 'lavfi',
               '-i', 'sine=frequency=880:duration=0.15:sample_rate=44100', '-ac', '2',
               '-c:a', 'libmp3lame', '-b:a', '128k', '-write_xing', '0', '-id3v2_version',
               '0', '-f', 'mp3', str(a.out)], check=True)
