"""Verify V0 native artifacts against acceptance cases B02 and B03.

Checks an APK, a directory, or individual ELF files:

  B02  every native ELF is arm64 bionic, every PT_LOAD is aligned to at least
       16 KiB, and nothing depends on glibc, a glibc loader, or GNU symbol
       versions.
  B03  the APK's uncompressed shared libraries are 16 KiB aligned in the zip.

Reports what it measured. A check that could not run is reported as such
rather than being counted as a pass.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zipfile
from dataclasses import dataclass, field, asdict
from pathlib import Path

REQUIRED_LOAD_ALIGN = 16384

# Any of these in DT_NEEDED means the artifact is not a bionic binary.
GLIBC_LIBRARIES = {
    "libc.so.6", "libm.so.6", "libdl.so.2", "libpthread.so.0",
    "librt.so.1", "libstdc++.so.6", "libgcc_s.so.1",
}
BIONIC_LIBRARIES = {"libc.so", "libm.so", "libdl.so", "liblog.so", "libc++_shared.so"}
BIONIC_LINKER = "/system/bin/linker64"


@dataclass
class Check:
    id: str
    name: str
    status: str  # PASS | FAIL | NOT_RUN
    detail: str = ""


@dataclass
class ElfReport:
    path: str
    sha256: str = ""
    machine: str = ""
    elf_class: str = ""
    build_id: str = ""
    needed: list[str] = field(default_factory=list)
    interpreter: str = ""
    min_load_align: int = 0
    checks: list[Check] = field(default_factory=list)


def find_readelf() -> str | None:
    """Prefer the NDK's llvm-readelf; fall back to whatever is on PATH."""
    sdk = os.environ.get("ANDROID_SDK_ROOT") or os.environ.get("ANDROID_HOME") \
        or str(Path.home() / "Library/Android/sdk")
    ndk_dir = Path(sdk) / "ndk"
    if ndk_dir.is_dir():
        for revision in sorted(ndk_dir.iterdir(), reverse=True):
            for host in ("darwin-x86_64", "linux-x86_64"):
                candidate = revision / "toolchains/llvm/prebuilt" / host / "bin/llvm-readelf"
                if candidate.is_file():
                    return str(candidate)
    for name in ("llvm-readelf", "readelf", "greadelf"):
        found = shutil.which(name)
        if found:
            return found
    return None


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def is_elf(path: Path) -> bool:
    try:
        with path.open("rb") as handle:
            return handle.read(4) == b"\x7fELF"
    except OSError:
        return False


def inspect_elf(path: Path, readelf: str) -> ElfReport:
    report = ElfReport(path=str(path), sha256=sha256_of(path))

    def run(args: list[str]) -> str:
        try:
            return subprocess.run([readelf, *args, str(path)], capture_output=True,
                                  text=True, timeout=60).stdout
        except (subprocess.SubprocessError, OSError):
            return ""

    header = run(["-h"])
    if match := re.search(r"Machine:\s+(.+)", header):
        report.machine = match.group(1).strip()
    if match := re.search(r"Class:\s+(.+)", header):
        report.elf_class = match.group(1).strip()

    dynamic = run(["-d"])
    report.needed = re.findall(r"\(NEEDED\).*?\[(.+?)\]", dynamic)

    program = run(["-l"])
    if match := re.search(r"interpreter:\s*([^\]]+)\]", program):
        report.interpreter = match.group(1).strip()
    aligns = [int(value, 16) for value in re.findall(r"^\s+LOAD.*?(0x[0-9a-f]+)\s*$",
                                                     program, re.MULTILINE)]
    report.min_load_align = min(aligns) if aligns else 0

    notes = run(["-n"])
    if match := re.search(r"Build ID:\s*([0-9a-f]+)", notes):
        report.build_id = match.group(1)

    versions = run(["-V"])

    # --- checks -------------------------------------------------------------
    report.checks.append(Check(
        "B02.arch", "arm64 ELF64",
        "PASS" if ("AArch64" in report.machine and "ELF64" in report.elf_class) else "FAIL",
        f"{report.elf_class} {report.machine}"))

    glibc_hits = sorted(set(report.needed) & GLIBC_LIBRARIES)
    report.checks.append(Check(
        "B02.bionic", "no glibc DT_NEEDED",
        "FAIL" if glibc_hits else "PASS",
        f"depends on {', '.join(glibc_hits)}" if glibc_hits
        else f"needed: {', '.join(report.needed) or 'none'}"))

    if report.interpreter:
        report.checks.append(Check(
            "B02.linker", "bionic loader",
            "PASS" if report.interpreter == BIONIC_LINKER else "FAIL",
            report.interpreter))
    else:
        # A shared library legitimately has no PT_INTERP.
        report.checks.append(Check("B02.linker", "bionic loader", "PASS",
                                   "no PT_INTERP (shared library)"))

    if report.min_load_align:
        report.checks.append(Check(
            "B02.align", f"PT_LOAD aligned to >= {REQUIRED_LOAD_ALIGN}",
            "PASS" if report.min_load_align >= REQUIRED_LOAD_ALIGN else "FAIL",
            f"min LOAD align 0x{report.min_load_align:x}"))
    else:
        report.checks.append(Check("B02.align", "PT_LOAD alignment", "NOT_RUN",
                                   "could not read program headers"))

    gnu_versions = re.findall(r"(GLIBC_[0-9.]+|GLIBCXX_[0-9.]+|CXXABI_[0-9.]+)", versions)
    report.checks.append(Check(
        "B02.symver", "no GNU symbol versions",
        "FAIL" if gnu_versions else "PASS",
        ", ".join(sorted(set(gnu_versions))) if gnu_versions else "none"))

    report.checks.append(Check(
        "B02.buildid", "Build ID present",
        "PASS" if report.build_id else "FAIL",
        report.build_id or "missing"))

    return report


def check_apk_alignment(apk: Path) -> list[Check]:
    """B03: uncompressed .so entries must start on a 16 KiB boundary."""
    checks: list[Check] = []
    zipalign = None
    sdk = os.environ.get("ANDROID_SDK_ROOT") or os.environ.get("ANDROID_HOME") \
        or str(Path.home() / "Library/Android/sdk")
    build_tools = Path(sdk) / "build-tools"
    if build_tools.is_dir():
        for revision in sorted(build_tools.iterdir(), reverse=True):
            candidate = revision / "zipalign"
            if candidate.is_file() and os.access(candidate, os.X_OK):
                zipalign = str(candidate)
                break

    if zipalign:
        result = subprocess.run([zipalign, "-c", "-P", "16", "-v", "4", str(apk)],
                                capture_output=True, text=True, timeout=300)
        checks.append(Check("B03.zipalign", "zipalign -c -P 16 -v 4",
                            "PASS" if result.returncode == 0 else "FAIL",
                            (result.stdout or result.stderr).strip().splitlines()[-1]
                            if (result.stdout or result.stderr) else ""))
    else:
        checks.append(Check("B03.zipalign", "zipalign -c -P 16 -v 4", "NOT_RUN",
                            "zipalign not found in build-tools"))

    # Independent check, so a missing zipalign does not leave B03 unverified.
    misaligned = []
    with zipfile.ZipFile(apk) as archive:
        for info in archive.infolist():
            if not info.filename.endswith(".so"):
                continue
            if info.compress_type != zipfile.ZIP_STORED:
                misaligned.append(f"{info.filename} (compressed)")
                continue
            with archive.open(info) as handle:
                pass
            header_offset = info.header_offset
            with apk.open("rb") as raw:
                raw.seek(header_offset + 26)
                name_len, extra_len = struct.unpack("<HH", raw.read(4))
            data_offset = header_offset + 30 + name_len + extra_len
            if data_offset % REQUIRED_LOAD_ALIGN != 0:
                misaligned.append(f"{info.filename} @ {data_offset}")
    checks.append(Check("B03.offsets", "uncompressed .so on 16 KiB boundaries",
                        "FAIL" if misaligned else "PASS",
                        "; ".join(misaligned) if misaligned else "all aligned"))
    return checks


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="APK, directory, or ELF file")
    parser.add_argument("--json", help="write a machine-readable report here")
    args = parser.parse_args()

    target = Path(args.target)
    if not target.exists():
        print(f"error: {target} does not exist", file=sys.stderr)
        return 1

    readelf = find_readelf()
    if readelf is None:
        print("error: no llvm-readelf or readelf found; cannot verify ELF properties",
              file=sys.stderr)
        return 1
    print(f"readelf: {readelf}")

    reports: list[ElfReport] = []
    apk_checks: list[Check] = []
    temp_dir: tempfile.TemporaryDirectory | None = None

    if target.suffix == ".apk":
        print(f"apk: {target}")
        print(f"apk sha256: {sha256_of(target)}")
        apk_checks = check_apk_alignment(target)
        temp_dir = tempfile.TemporaryDirectory()
        with zipfile.ZipFile(target) as archive:
            for info in archive.infolist():
                if info.filename.endswith(".so"):
                    archive.extract(info, temp_dir.name)
        search_root = Path(temp_dir.name)
        candidates = sorted(search_root.rglob("*.so"))
    elif target.is_dir():
        candidates = [p for p in sorted(target.rglob("*")) if p.is_file() and is_elf(p)]
    else:
        candidates = [target]

    if not candidates:
        print("error: no native ELF objects found in the target", file=sys.stderr)
        return 1

    for path in candidates:
        reports.append(inspect_elf(path, readelf))

    failures = 0
    not_run = 0
    print()
    for check in apk_checks:
        print(f"[{check.status:7s}] {check.id:16s} {check.name}: {check.detail}")
        failures += check.status == "FAIL"
        not_run += check.status == "NOT_RUN"

    for report in reports:
        display = Path(report.path).name
        print(f"\n{display}")
        print(f"  sha256   {report.sha256}")
        print(f"  build-id {report.build_id or '(none)'}")
        for check in report.checks:
            print(f"  [{check.status:7s}] {check.id:14s} {check.detail}")
            failures += check.status == "FAIL"
            not_run += check.status == "NOT_RUN"

    print(f"\n{len(reports)} object(s) inspected, {failures} failure(s), {not_run} not run")
    if not_run:
        print("NOT_RUN items are unverified. They are not passes.")

    if args.json:
        payload = {
            "target": str(target),
            "readelf": readelf,
            "apk_checks": [asdict(c) for c in apk_checks],
            "objects": [asdict(r) for r in reports],
            "failures": failures,
            "not_run": not_run,
        }
        Path(args.json).write_text(json.dumps(payload, indent=2))
        print(f"wrote {args.json}")

    if temp_dir:
        temp_dir.cleanup()
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
