#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 1 || $# -gt 2 || (${2:-} != '' && ${2:-} != '--open_last_game') ]]; then
    echo "Usage: $0 SERIAL [--open_last_game]" >&2
    exit 2
fi
exec adb -s "$1" shell am start -W -n com.shadps4.android/.MainActivity \
    -f 0x24000000 --ez open_last_game true
