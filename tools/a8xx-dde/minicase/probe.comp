#version 460
// One workgroup per indirect dispatch: counters[index] counts how many workgroups the CP
// launched from the VkDispatchIndirectCommand it read. 1 = read correctly, 0 = read zeros.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer U32 { uint v[]; };
layout(push_constant) uniform PC { uvec2 counters; uint index; } pc;
void main() { atomicAdd(U32(pc.counters).v[pc.index], 1u); }
